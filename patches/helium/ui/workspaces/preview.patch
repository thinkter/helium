+void WorkspaceController::MaybeScheduleDeveloperPreview() {
+  const auto* command = base::CommandLine::ForCurrentProcess();
+  if (preview_scheduled_ || preview_attempted_ || tracking_ ||
+      !command->HasSwitch("helium-workspace-developer-preview") ||
+      !base::FeatureList::IsEnabled(kWorkspaceTabTracking) ||
+      !base::FeatureList::IsEnabled(kWorkspaceContentsHost) ||
+      window_->GetType() != BrowserWindowInterface::TYPE_NORMAL ||
+      window_->GetProfile()->IsOffTheRecord() ||
+      window_->GetProfile()->GetPrefs()->GetInitializationStatus() !=
+          PrefService::INITIALIZATION_STATUS_CREATED_NEW_PREF_STORE ||
+      !window_->GetTabStripModel()->GetActiveTab()) {
+    return;
+  }
+  // IsNewProfile() also returns true on application first-run with existing
+  // preferences. Require an actually new pref store, never that shortcut.
+  const auto directory = command->GetSwitchValuePath(switches::kUserDataDir);
+  if (!directory.IsAbsolute() ||
+      !directory.BaseName().AsUTF8Unsafe().starts_with(
+          "helium-workspace-preview-")) {
+    return;
+  }
+  auto* view = BrowserView::GetBrowserViewForBrowser(
+      window_->GetBrowserForMigrationOnly());
+  if (!view || view->contents_container()->bounds().IsEmpty()) {
+    return;
+  }
+  // Leave the initial layout/tab observer stack before any native transfer.
+  preview_scheduled_ = true;
+  base::SingleThreadTaskRunner::GetCurrentDefault()->PostNonNestableTask(
+      FROM_HERE, base::BindOnce(&WorkspaceController::StartDeveloperPreview,
+                                lifetime_.GetWeakPtr()));
+}
+
+void WorkspaceController::StartDeveloperPreview() {
+  preview_scheduled_ = false;
+  preview_attempted_ = true;
+  // At most one eligible window per process, including after stop/failure.
+  static bool claimed = false;
+  auto* strip = window_->GetTabStripModel();
+  auto* view = BrowserView::GetBrowserViewForBrowser(
+      window_->GetBrowserForMigrationOnly());
+  if (claimed || tracking_ || !view || !view->GetWidget() ||
+      view->GetWidget()->IsClosed() || view->IsFullscreen()) {
+    return;
+  }
+  // A first layout may precede Show(). Retry only this startup readiness, not
+  // rejected profiles/tabs or a stopped preview. Destruction cancels the task.
+  if (!view->GetWidget()->IsVisible() ||
+      view->contents_container()->bounds().IsEmpty()) {
+    if (++preview_startup_retries_ <= 10) {
+      base::SingleThreadTaskRunner::GetCurrentDefault()->PostNonNestableDelayedTask(
+          FROM_HERE, base::BindOnce(&WorkspaceController::StartDeveloperPreview,
+                                    lifetime_.GetWeakPtr()),
+          base::Milliseconds(100));
+    }
+    return;
+  }
+  if (strip->count() != 1 ||
+      strip->GetActiveWebContents()->GetVisibleURL() != GURL("about:blank") ||
+      HasNativeSplit()) {
+    return;
+  }
+  claimed = true;
+  auto weak = lifetime_.GetWeakPtr();
+  // Ordinary navigation and tab creation only. No second WebContents owner.
+  strip->GetActiveWebContents()->GetController().LoadURL(
+      GURL("data:text/html,<title>T11 PREVIEW - left</title>"
+           "<h1>T11 developer preview</h1><p>Disposable profile only.</p>"
+           "<p>Fullscreen and DevTools end tiling. Dialogs, permissions, find, "
+           "side panels and accessories are NOT validated. No T12/T13 support."
+           "</p><p>Click panes, use right-side headers, drag dividers. "
+           "Ordinary close and move remain Chromium-owned.</p>"
+           "<input placeholder='Left pane focus check'>"),
+      content::Referrer(), ui::PAGE_TRANSITION_TYPED, std::string());
+  for (const char* page : {
+           "data:text/html,<title>Right single page</title><h1>Right single page"
+           "</h1><p>Select the other header for a nested split.</p>"
+           "<input placeholder='Single page focus check'>",
+           "data:text/html,<title>Nested upper</title><h1>Nested upper</h1>"
+           "<input placeholder='Upper pane focus check'>",
+           "data:text/html,<title>Nested lower</title><h1>Nested lower</h1>"
+           "<input placeholder='Lower pane focus check'>"}) {
+    if (!weak) {
+      return;
+    }
+    chrome::AddTabAt(window_, GURL(page), -1, false);
+  }
+  if (!weak || strip->count() != 4 ||
+      StartTracking() != StartResult::kStarted || !weak) {
+    return;
+  }
+  developer_preview_ = true;
+  // Build a candidate with the same real tab associations, using only model
+  // mutations: H(left, Tabbed(single, V(upper, lower))). Commit once; active
+  // Chromium tab remains the left page throughout native presentation.
+  WorkspaceLayoutModel candidate;
+  const auto key = [this, strip](int i) {
+    return KeyForTab(strip->GetTabAtIndex(i));
+  };
+  candidate.CreateWorkspace(key(0), workspace_ids_, node_ids_);
+  const auto active_leaf = [&candidate]() {
+    return candidate.workspaces.front().active_leaf;
+  };
+  bool valid = candidate.SplitLeaf(active_leaf(), LayoutKind::kHorizontal,
+                                   key(1), node_ids_) &&
+               candidate.SplitLeaf(active_leaf(), LayoutKind::kVertical,
+                                   key(2), node_ids_) &&
+               candidate.SetLayout(LayoutKind::kTabbed, node_ids_) &&
+               candidate.SplitLeaf(active_leaf(), LayoutKind::kVertical,
+                                   key(3), node_ids_) &&
+               candidate.RevealTab(key(0)) && candidate.Validate();
+  if (!valid) {
+    StopDeveloperPreview();
+    return;
+  }
+  CancelInput();
+  ++generation_;
+  model_ = std::move(candidate);
+  PresentHost();
+}
+
+void WorkspaceController::StopDeveloperPreview() {
+  if (std::exchange(developer_preview_, false)) {
+    StopTracking();
+  }
+}
+
 void WorkspaceController::OnHostLayoutChanged() {
   PresentHost();
 }
