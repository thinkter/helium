+// Compare every topology/association/weight field, including inactive trees.
+void ExpectSameTopology(const WorkspaceLayoutModel& before,
+                        const WorkspaceLayoutModel& after) {
+  ASSERT_EQ(before.nodes.size(), after.nodes.size());
+  for (const auto& [id, node] : before.nodes) {
+    ASSERT_TRUE(after.nodes.contains(id));
+    const auto& other = after.nodes.at(id);
+    ASSERT_EQ(node.index(), other.index());
+    if (const auto* leaf = std::get_if<LeafState>(&node)) {
+      EXPECT_EQ(leaf->tab, std::get<LeafState>(other).tab);
+    } else {
+      const auto& container = std::get<ContainerState>(node);
+      const auto& other_container = std::get<ContainerState>(other);
+      EXPECT_EQ(container.children, other_container.children);
+      EXPECT_EQ(container.split_weights, other_container.split_weights);
+    }
+  }
+  ASSERT_EQ(before.workspaces.size(), after.workspaces.size());
+  for (size_t i = 0; i < before.workspaces.size(); ++i) {
+    EXPECT_EQ(before.workspaces[i].id, after.workspaces[i].id);
+    EXPECT_EQ(before.workspaces[i].root, after.workspaces[i].root);
+  }
+  EXPECT_EQ(before.active_workspace, after.active_workspace);
+}
+
+void ExpectSameState(const WorkspaceLayoutModel& before,
+                     const WorkspaceLayoutModel& after) {
+  ExpectSameTopology(before, after);
+  for (const auto& [id, node] : before.nodes) {
+    if (const auto* container = std::get_if<ContainerState>(&node)) {
+      const auto& other = std::get<ContainerState>(after.nodes.at(id));
+      EXPECT_EQ(container->layout, other.layout);
+      EXPECT_EQ(container->selected_child, other.selected_child);
+      EXPECT_EQ(container->last_focused_leaf, other.last_focused_leaf);
+    }
+  }
+  for (size_t i = 0; i < before.workspaces.size(); ++i) {
+    EXPECT_EQ(before.workspaces[i].selected_node,
+              after.workspaces[i].selected_node);
+    EXPECT_EQ(before.workspaces[i].active_leaf,
+              after.workspaces[i].active_leaf);
+  }
+}
