+TEST(WorkspaceLayoutModelTest, EmptyTargetsAndRejectedMutationsAreAtomic) {
+  NodeId::Generator ids;
+  auto model = Sample();
+  const auto before = model;
+  EXPECT_FALSE(model.SelectNode({}));
+  EXPECT_FALSE(model.SelectNode(N(99)));
+  EXPECT_FALSE(model.SelectNode(N(9)));
+  EXPECT_FALSE(model.SetSelectedChild(N(9), N(9)));
+  EXPECT_FALSE(model.SetSelectedChild(N(2), N(2)));
+  EXPECT_FALSE(model.SetSelectedChild(N(1), N(5)));
+  EXPECT_FALSE(model.SetSelectedChild(N(99), N(2)));
+  EXPECT_FALSE(model.SetLayout(static_cast<LayoutKind>(99), ids));
+  ExpectSameState(before, model);
+  for (auto empty : {WorkspaceLayoutModel(), Sample()}) {
+    if (!empty.workspaces.empty()) {
+      empty.active_workspace = W(3);
+    }
+    const auto expected = empty;
+    EXPECT_FALSE(empty.ResolveLayoutTarget());
+    EXPECT_FALSE(empty.SelectParent());
+    EXPECT_FALSE(empty.SelectChild());
+    EXPECT_FALSE(empty.SelectNode(N(1)));
+    EXPECT_FALSE(empty.SetSelectedChild(N(1), N(2)));
+    EXPECT_FALSE(empty.SetLayout(LayoutKind::kTabbed, ids));
+    ExpectSameState(expected, empty);
+    EXPECT_TRUE(empty.Validate());
+  }
+  Container(model, 4).children[0] = N(4);  // Invalid cyclic candidate.
+  const auto invalid = model;
+  EXPECT_FALSE(model.SelectNode(N(1)));
+  EXPECT_FALSE(model.SelectParent());
+  EXPECT_FALSE(model.SelectChild());
+  EXPECT_FALSE(model.ResolveLayoutTarget());
+  EXPECT_FALSE(model.SetLayout(LayoutKind::kHorizontal, ids));
+  EXPECT_FALSE(model.SetSelectedChild(N(1), N(2)));
+  ExpectSameState(invalid, model);
+  EXPECT_EQ(ids.GenerateNextId(), N(1));
+}
