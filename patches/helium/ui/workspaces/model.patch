+// Copyright 2026 The Helium Authors
+// You can use, redistribute, and/or modify this source code under
+// the terms of the GPL-3.0 license that can be found in the LICENSE file.
+
+#include "chrome/browser/ui/helium/workspaces/workspace_layout_model.h"
+
+#include <algorithm>
+#include <cmath>
+#include <set>
+#include <utility>
+
+namespace helium::workspaces {
+namespace {
+
+WorkspaceState* ActiveWorkspace(WorkspaceLayoutModel& model) {
+  for (auto& workspace : model.workspaces) {
+    if (workspace.id == model.active_workspace) {
+      return &workspace;
+    }
+  }
+  return nullptr;
+}
+
+// Call only on a validated forest. Derive parent links rather than storing a
+// second copy of topology in the model.
+NodeId Parent(const WorkspaceLayoutModel& model, NodeId child) {
+  for (const auto& [id, node] : model.nodes) {
+    const auto* container = std::get_if<ContainerState>(&node);
+    if (container && std::ranges::contains(container->children, child)) {
+      return id;
+    }
+  }
+  return {};
+}
+
+bool Contains(const WorkspaceLayoutModel& model, NodeId root, NodeId node) {
+  while (node) {
+    if (node == root) {
+      return true;
+    }
+    node = Parent(model, node);
+  }
+  return false;
+}
+
+}  // namespace
+
+bool WorkspaceLayoutModel::SelectNode(NodeId node) {
+  if (!Validate()) {
+    return false;
+  }
+  auto* workspace = ActiveWorkspace(*this);
+  if (!workspace || !Contains(*this, workspace->root, node)) {
+    return false;
+  }
+  workspace->selected_node = node;
+  return true;
+}
+
+bool WorkspaceLayoutModel::SelectParent() {
+  if (!Validate()) {
+    return false;
+  }
+  const auto* workspace = ActiveWorkspace(*this);
+  return workspace && SelectNode(Parent(*this, workspace->selected_node));
+}
+
+bool WorkspaceLayoutModel::SelectChild() {
+  if (!Validate()) {
+    return false;
+  }
+  const auto* workspace = ActiveWorkspace(*this);
+  if (!workspace || !workspace->selected_node) {
+    return false;
+  }
+  const auto* container =
+      std::get_if<ContainerState>(&nodes.at(workspace->selected_node));
+  return container && SelectNode(container->selected_child);
+}
+
+NodeId WorkspaceLayoutModel::ResolveLayoutTarget() const {
+  if (!Validate()) {
+    return {};
+  }
+  for (const auto& workspace : workspaces) {
+    if (workspace.id != active_workspace || !workspace.selected_node) {
+      continue;
+    }
+    NodeId selected = workspace.selected_node;
+    if (std::holds_alternative<ContainerState>(nodes.at(selected))) {
+      return selected;
+    }
+    NodeId parent = Parent(*this, selected);
+    return parent ? parent : selected;
+  }
+  return {};
+}
+
+bool WorkspaceLayoutModel::SetLayout(LayoutKind layout,
+                                     NodeId::Generator& node_ids) {
+  switch (layout) {
+    case LayoutKind::kHorizontal:
+    case LayoutKind::kVertical:
+    case LayoutKind::kTabbed:
+      break;
+    default:
+      return false;
+  }
+  NodeId target = ResolveLayoutTarget();
+  if (!target) {
+    return false;
+  }
+  auto candidate = *this;
+  auto* workspace = ActiveWorkspace(candidate);
+  if (auto* container =
+          std::get_if<ContainerState>(&candidate.nodes.at(target))) {
+    container->layout = layout;
+    // Converting a split must not hide its active page. Hidden targets keep
+    // their remembered child; changing their layout does not activate them.
+    if (layout == LayoutKind::kTabbed &&
+        Contains(candidate, target, workspace->active_leaf)) {
+      NodeId child = workspace->active_leaf;
+      while (Parent(candidate, child) != target) {
+        child = Parent(candidate, child);
+      }
+      container->selected_child = child;
+    }
+  } else {
+    NodeId wrapper;
+    do {
+      wrapper = node_ids.GenerateNextId();
+    } while (candidate.nodes.contains(wrapper));
+    candidate.nodes.emplace(
+        wrapper, ContainerState{layout, {target}, target, {1}, target});
+    workspace->root = wrapper;
+    workspace->selected_node = wrapper;
+  }
+  if (!candidate.Validate()) {
+    return false;
+  }
+  *this = std::move(candidate);
+  return true;
+}
+
+bool WorkspaceLayoutModel::SetSelectedChild(NodeId container_id, NodeId child) {
+  if (!Validate()) {
+    return false;
+  }
+  const auto* workspace = ActiveWorkspace(*this);
+  if (!workspace || !Contains(*this, workspace->root, container_id)) {
+    return false;
+  }
+  const auto* container = std::get_if<ContainerState>(&nodes.at(container_id));
+  if (!container || !std::ranges::contains(container->children, child)) {
+    return false;
+  }
+  auto candidate = *this;
+  auto* next_workspace = ActiveWorkspace(candidate);
+  NodeId leaf = workspace->active_leaf;
+  if (!Contains(candidate, child, leaf)) {
+    const auto* subtree = std::get_if<ContainerState>(&nodes.at(child));
+    leaf = subtree ? subtree->last_focused_leaf : child;
+  }
+  // Reveal the remembered leaf even if its historical path is now hidden.
+  for (NodeId descendant = leaf, parent = Parent(candidate, descendant); parent;
+       descendant = parent, parent = Parent(candidate, parent)) {
+    auto& ancestor = std::get<ContainerState>(candidate.nodes.at(parent));
+    ancestor.selected_child = descendant;
+    ancestor.last_focused_leaf = leaf;
+  }
+  next_workspace->active_leaf = leaf;
+  next_workspace->selected_node = child;
+  if (!candidate.Validate()) {
+    return false;
+  }
+  *this = std::move(candidate);
+  return true;
+}
+
+bool WorkspaceLayoutModel::Validate() const {
+  std::set<WorkspaceId> workspace_ids;
+  std::set<NodeId> visited;
+  std::set<TabKey> tabs;
+  std::map<NodeId, NodeId> parents;
+
+  for (const auto& workspace : workspaces) {
+    if (!workspace.id || !workspace_ids.insert(workspace.id).second) {
+      return false;
+    }
+    if (!workspace.root) {
+      if (workspace.selected_node || workspace.active_leaf) {
+        return false;
+      }
+      continue;
+    }
+
+    std::set<NodeId> members;
+    std::set<NodeId> visible_leaves;
+    // Iterative traversal rejects cycles/shared children without risking stack
+    // exhaustion on malformed or deeply nested input.
+    std::vector<std::pair<NodeId, bool>> pending = {{workspace.root, true}};
+    while (!pending.empty()) {
+      const auto [id, visible] = pending.back();
+      pending.pop_back();
+      const auto it = nodes.find(id);
+      if (!id || it == nodes.end() || !visited.insert(id).second) {
+        return false;
+      }
+      members.insert(id);
+      if (const auto* leaf = std::get_if<LeafState>(&it->second)) {
+        if (!leaf->tab || !tabs.insert(leaf->tab).second) {
+          return false;
+        }
+        if (visible) {
+          visible_leaves.insert(id);
+        }
+        continue;
+      }
+
+      const auto& container = std::get<ContainerState>(it->second);
+      switch (container.layout) {
+        case LayoutKind::kHorizontal:
+        case LayoutKind::kVertical:
+        case LayoutKind::kTabbed:
+          break;
+        default:
+          return false;
+      }
+      if (container.children.empty() ||
+          container.children.size() != container.split_weights.size() ||
+          !std::ranges::contains(container.children,
+                                 container.selected_child)) {
+        return false;
+      }
+      for (double weight : container.split_weights) {
+        if (!std::isfinite(weight) || weight <= 0) {
+          return false;
+        }
+      }
+      for (NodeId child : container.children) {
+        if (!parents.emplace(child, id).second) {
+          return false;
+        }
+        pending.emplace_back(
+            child, visible && (container.layout != LayoutKind::kTabbed ||
+                               child == container.selected_child));
+      }
+    }
+    if (!members.contains(workspace.selected_node) ||
+        !visible_leaves.contains(workspace.active_leaf)) {
+      return false;
+    }
+  }
+
+  if (visited.size() != nodes.size() ||
+      (workspaces.empty() ? !!active_workspace
+                          : !workspace_ids.contains(active_workspace))) {
+    return false;
+  }
+
+  // Traversal above established an acyclic forest. Check remembered focus even
+  // for hidden containers; it must name a leaf in that container's subtree.
+  for (const auto& [id, node] : nodes) {
+    const auto* container = std::get_if<ContainerState>(&node);
+    if (!container) {
+      continue;
+    }
+    auto focus = nodes.find(container->last_focused_leaf);
+    if (focus == nodes.end() ||
+        !std::holds_alternative<LeafState>(focus->second)) {
+      return false;
+    }
+    NodeId ancestor = focus->first;
+    while (ancestor != id) {
+      const auto parent = parents.find(ancestor);
+      if (parent == parents.end()) {
+        return false;
+      }
+      ancestor = parent->second;
+    }
+  }
+  return true;
+}
+
+}  // namespace helium::workspaces
