+TEST(WorkspaceLayoutModelTest, SingletonRootWrapsOnceAndRetainsUnaryNode) {
+  for (auto layout :
+       {LayoutKind::kHorizontal, LayoutKind::kVertical, LayoutKind::kTabbed}) {
+    auto model = Sample();
+    model.active_workspace = W(2);
+    NodeId::Generator ids;  // Deliberately starts below existing node IDs.
+    EXPECT_EQ(model.ResolveLayoutTarget(), N(9));
+    ASSERT_TRUE(model.SetLayout(layout, ids));
+    EXPECT_EQ(model.nodes.size(), 10u);
+    EXPECT_EQ(model.workspaces[1].root, N(10));
+    EXPECT_EQ(model.workspaces[1].selected_node, N(10));
+    EXPECT_EQ(model.workspaces[1].active_leaf, N(9));
+    EXPECT_EQ(Container(model, 10).children, std::vector<NodeId>{N(9)});
+    EXPECT_EQ(Container(model, 10).split_weights, std::vector<double>{1});
+    EXPECT_EQ(Container(model, 10).last_focused_leaf, N(9));
+    EXPECT_TRUE(model.Validate());
+    const auto expected = model;
+    ASSERT_TRUE(model.SetLayout(layout, ids));
+    ExpectSameState(expected, model);
+    ASSERT_TRUE(model.SelectChild());
+    ASSERT_TRUE(model.SetLayout(layout, ids));
+    EXPECT_EQ(model.nodes.size(), 10u);
+    EXPECT_EQ(ids.GenerateNextId(), N(11));
+    EXPECT_TRUE(model.Validate());
+  }
+}
