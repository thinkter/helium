+TEST(WorkspaceLayoutModelTest, MutationRejectionsAreAtomicAndDoNotAllocate) {
+  for (bool invalid : {false, true}) {
+    auto model = Sample();
+    if (invalid) {
+      Container(model, 4).children[0] = N(4);
+    }
+    const auto before = model;
+    NodeId::Generator nodes;
+    WorkspaceId::Generator workspaces;
+    const std::vector<std::function<bool()>> rejected = {
+        [&] { return !!model.CreateWorkspace(T(1), workspaces, nodes); },
+        [&] { return model.SwitchWorkspace(W(99)); },
+        [&] { return model.RevealTab(T(99)); },
+        [&] { return model.RemoveConfirmedTab(T(99)); },
+        [&] {
+          return model.SplitLeaf(N(3), LayoutKind::kHorizontal, T(7), nodes);
+        },
+        [&] { return model.SplitLeaf(N(2), LayoutKind::kTabbed, T(7), nodes); },
+        [&] {
+          return model.SplitLeaf(N(2), LayoutKind::kVertical, T(1), nodes);
+        },
+        [&] {
+          return model.InsertTab(T(1), {}, OpenDisposition::kForeground, nodes);
+        },
+        [&] {
+          return model.InsertTab({}, {}, OpenDisposition::kBackground, nodes);
+        },
+        [&] {
+          return model.InsertTab(T(7), {}, static_cast<OpenDisposition>(99),
+                                 nodes);
+        },
+    };
+    for (const auto& operation : rejected) {
+      EXPECT_FALSE(operation());
+      ExpectSameState(before, model);
+    }
+    if (invalid) {
+      EXPECT_FALSE(model.CreateWorkspace(T(7), workspaces, nodes));
+      EXPECT_FALSE(model.SwitchWorkspace(W(2)));
+      EXPECT_FALSE(model.RevealTab(T(1)));
+      EXPECT_FALSE(model.RemoveConfirmedTab(T(1)));
+      EXPECT_FALSE(model.SplitLeaf(N(2), LayoutKind::kHorizontal, T(7), nodes));
+      EXPECT_FALSE(
+          model.InsertTab(T(7), {}, OpenDisposition::kForeground, nodes));
+      ExpectSameState(before, model);
+    }
+    EXPECT_EQ(nodes.GenerateNextId(), N(1));
+    EXPECT_EQ(workspaces.GenerateNextId(), W(1));
+  }
+}
