+// Copyright 2026 The Helium Authors
+// You can use, redistribute, and/or modify this source code under
+// the terms of the GPL-3.0 license that can be found in the LICENSE file.
+
+#include "chrome/browser/ui/helium/workspaces/workspace_layout_model.h"
+
+#include <limits>
+
+#include "testing/gtest/include/gtest/gtest.h"
+
+namespace helium::workspaces {
+namespace {
+
+constexpr NodeId N(unsigned value) {
+  return NodeId::FromUnsafeValue(value);
+}
+constexpr WorkspaceId W(unsigned value) {
+  return WorkspaceId::FromUnsafeValue(value);
+}
+constexpr TabKey T(unsigned value) {
+  return TabKey::FromUnsafeValue(value);
+}
+
+// H(email, Tabbed(V(a,b), c), d): three root children, with an entire
+// split subtree selected by the tabbed container. Selection is not activation.
+WorkspaceLayoutModel Sample() {
+  WorkspaceLayoutModel model;
+  model.nodes = {
+      {N(1),
+       ContainerState{
+           LayoutKind::kHorizontal, {N(2), N(3), N(8)}, N(3), {2, 3, 1}, N(5)}},
+      {N(2), LeafState{T(1)}},
+      {N(3),
+       ContainerState{LayoutKind::kTabbed, {N(4), N(7)}, N(4), {1, 2}, N(5)}},
+      {N(4),
+       ContainerState{LayoutKind::kVertical, {N(5), N(6)}, N(5), {1, 1}, N(5)}},
+      {N(5), LeafState{T(2)}},
+      {N(6), LeafState{T(3)}},
+      {N(7), LeafState{T(4)}},
+      {N(8), LeafState{T(5)}},
+      {N(9), LeafState{T(6)}},
+  };
+  model.workspaces = {
+      {W(1), N(1), N(3), N(5)}, {W(2), N(9), N(9), N(9)}, {W(3), {}, {}, {}}};
+  model.active_workspace = W(1);
+  return model;
+}
+
+ContainerState& Container(WorkspaceLayoutModel& model, unsigned id) {
+  return std::get<ContainerState>(model.nodes.at(N(id)));
+}
+
+TEST(WorkspaceLayoutModelTest, RecursiveForestAndIndependentSelection) {
+  const auto model = Sample();
+  EXPECT_TRUE(model.Validate());
+  EXPECT_NE(model.workspaces[0].selected_node, model.workspaces[0].active_leaf);
+}
+
+TEST(WorkspaceLayoutModelTest, EmptyModelAndEmptyActiveWorkspace) {
+  EXPECT_TRUE(WorkspaceLayoutModel().Validate());
+  auto model = Sample();
+  model.active_workspace = W(3);
+  EXPECT_TRUE(model.Validate());
+}
+
+TEST(WorkspaceLayoutModelTest, UnaryContainersAreMeaningful) {
+  WorkspaceLayoutModel model;
+  model.nodes = {
+      {N(1), ContainerState{LayoutKind::kTabbed, {N(2)}, N(2), {1}, N(2)}},
+      {N(2), LeafState{T(1)}}};
+  model.workspaces = {{W(1), N(1), N(1), N(2)}};
+  model.active_workspace = W(1);
+  EXPECT_TRUE(model.Validate());
+}
+
+TEST(WorkspaceLayoutModelTest, RejectsDuplicateAndNullAssociations) {
+  auto model = Sample();
+  model.nodes.at(N(9)) = LeafState{T(1)};
+  EXPECT_FALSE(model.Validate());
+  model.nodes.at(N(9)) = LeafState{};
+  EXPECT_FALSE(model.Validate());
+}
+
+TEST(WorkspaceLayoutModelTest, RejectsSelectionOutsideWorkspace) {
+  for (NodeId selection : {NodeId(), N(9), N(99)}) {
+    auto model = Sample();
+    model.workspaces[0].selected_node = selection;
+    EXPECT_FALSE(model.Validate());
+  }
+}
+
+TEST(WorkspaceLayoutModelTest, RejectsInvalidOrHiddenActiveLeaf) {
+  for (NodeId active : {NodeId(), N(3), N(7), N(9), N(99)}) {
+    auto model = Sample();
+    model.workspaces[0].active_leaf = active;
+    EXPECT_FALSE(model.Validate());
+  }
+}
+
+TEST(WorkspaceLayoutModelTest, RejectsNonChildSelectionForEveryLayout) {
+  for (auto layout :
+       {LayoutKind::kHorizontal, LayoutKind::kVertical, LayoutKind::kTabbed}) {
+    auto model = Sample();
+    Container(model, 3).layout = layout;
+    Container(model, 3).selected_child = N(5);
+    EXPECT_FALSE(model.Validate());
+  }
+}
+
+TEST(WorkspaceLayoutModelTest, RejectsCyclesIncludingHiddenSubtrees) {
+  auto model = Sample();
+  model.nodes.at(N(7)) =
+      ContainerState{LayoutKind::kTabbed, {N(3)}, N(3), {1}, N(5)};
+  EXPECT_FALSE(model.Validate());
+  Container(model, 7).children = {N(7)};
+  Container(model, 7).selected_child = N(7);
+  EXPECT_FALSE(model.Validate());
+}
+
+TEST(WorkspaceLayoutModelTest, RejectsSharedAndRepeatedChildren) {
+  auto model = Sample();
+  Container(model, 4).children = {N(5), N(2)};
+  EXPECT_FALSE(model.Validate());
+  Container(model, 4).children = {N(5), N(5)};
+  EXPECT_FALSE(model.Validate());
+}
+
+TEST(WorkspaceLayoutModelTest, RejectsMissingAndOrphanNodes) {
+  auto model = Sample();
+  model.nodes.erase(N(7));
+  EXPECT_FALSE(model.Validate());
+  model = Sample();
+  model.nodes.emplace(N(99), LeafState{T(99)});
+  EXPECT_FALSE(model.Validate());
+}
+
+TEST(WorkspaceLayoutModelTest, RejectsNullNodeId) {
+  auto model = Sample();
+  model.nodes.emplace(NodeId(), LeafState{T(99)});
+  EXPECT_FALSE(model.Validate());
+}
+
+TEST(WorkspaceLayoutModelTest, RejectsInvalidRememberedFocus) {
+  for (NodeId focus : {NodeId(), N(3), N(2), N(99)}) {
+    auto model = Sample();
+    Container(model, 3).last_focused_leaf = focus;
+    EXPECT_FALSE(model.Validate());
+  }
+}
+
+TEST(WorkspaceLayoutModelTest, RejectsInvalidWeightsAndArity) {
+  for (double weight : {0.0, -1.0, std::numeric_limits<double>::infinity(),
+                        std::numeric_limits<double>::quiet_NaN()}) {
+    auto model = Sample();
+    Container(model, 3).split_weights[0] = weight;
+    EXPECT_FALSE(model.Validate());
+  }
+  auto model = Sample();
+  Container(model, 3).split_weights.pop_back();
+  EXPECT_FALSE(model.Validate());
+  Container(model, 3).children.clear();
+  Container(model, 3).split_weights.clear();
+  EXPECT_FALSE(model.Validate());
+}
+
+TEST(WorkspaceLayoutModelTest, RejectsUnknownLayout) {
+  auto model = Sample();
+  Container(model, 3).layout = static_cast<LayoutKind>(99);
+  EXPECT_FALSE(model.Validate());
+}
+
+TEST(WorkspaceLayoutModelTest, RejectsInvalidWorkspaceState) {
+  auto model = Sample();
+  model.workspaces[1].id = W(1);
+  EXPECT_FALSE(model.Validate());
+  model = Sample();
+  model.workspaces[1].id = {};
+  EXPECT_FALSE(model.Validate());
+  model = Sample();
+  model.active_workspace = W(99);
+  EXPECT_FALSE(model.Validate());
+  model = {};
+  model.active_workspace = W(1);
+  EXPECT_FALSE(model.Validate());
+}
+
+TEST(WorkspaceLayoutModelTest, RejectsSharedRootsAndInvalidEmptyShells) {
+  auto model = Sample();
+  model.workspaces[2] = {W(3), N(9), N(9), N(9)};
+  EXPECT_FALSE(model.Validate());
+  model = Sample();
+  model.workspaces[2].selected_node = N(1);
+  EXPECT_FALSE(model.Validate());
+  model.workspaces[2].selected_node = {};
+  model.workspaces[2].active_leaf = N(2);
+  EXPECT_FALSE(model.Validate());
+}
+
+TEST(WorkspaceLayoutModelTest, TypedGeneratorsAndCopiesPreserveIdentity) {
+  NodeId::Generator nodes;
+  TabKey::Generator tabs;
+  const auto first = nodes.GenerateNextId();
+  EXPECT_TRUE(first);
+  EXPECT_NE(first, nodes.GenerateNextId());
+  EXPECT_TRUE(tabs.GenerateNextId());
+  auto model = Sample();
+  auto copy = model;
+  EXPECT_EQ(copy.workspaces[0].root, model.workspaces[0].root);
+  EXPECT_EQ(std::get<LeafState>(copy.nodes.at(N(2))).tab, T(1));
+  EXPECT_TRUE(copy.Validate());
+}
+
+// Compare every topology/association/weight field, including inactive trees.
+void ExpectSameTopology(const WorkspaceLayoutModel& before,
+                        const WorkspaceLayoutModel& after) {
+  ASSERT_EQ(before.nodes.size(), after.nodes.size());
+  for (const auto& [id, node] : before.nodes) {
+    ASSERT_TRUE(after.nodes.contains(id));
+    const auto& other = after.nodes.at(id);
+    ASSERT_EQ(node.index(), other.index());
+    if (const auto* leaf = std::get_if<LeafState>(&node)) {
+      EXPECT_EQ(leaf->tab, std::get<LeafState>(other).tab);
+    } else {
+      const auto& container = std::get<ContainerState>(node);
+      const auto& other_container = std::get<ContainerState>(other);
+      EXPECT_EQ(container.children, other_container.children);
+      EXPECT_EQ(container.split_weights, other_container.split_weights);
+    }
+  }
+  ASSERT_EQ(before.workspaces.size(), after.workspaces.size());
+  for (size_t i = 0; i < before.workspaces.size(); ++i) {
+    EXPECT_EQ(before.workspaces[i].id, after.workspaces[i].id);
+    EXPECT_EQ(before.workspaces[i].root, after.workspaces[i].root);
+  }
+  EXPECT_EQ(before.active_workspace, after.active_workspace);
+}
+
+void ExpectSameState(const WorkspaceLayoutModel& before,
+                     const WorkspaceLayoutModel& after) {
+  ExpectSameTopology(before, after);
+  for (const auto& [id, node] : before.nodes) {
+    if (const auto* container = std::get_if<ContainerState>(&node)) {
+      const auto& other = std::get<ContainerState>(after.nodes.at(id));
+      EXPECT_EQ(container->layout, other.layout);
+      EXPECT_EQ(container->selected_child, other.selected_child);
+      EXPECT_EQ(container->last_focused_leaf, other.last_focused_leaf);
+    }
+  }
+  for (size_t i = 0; i < before.workspaces.size(); ++i) {
+    EXPECT_EQ(before.workspaces[i].selected_node,
+              after.workspaces[i].selected_node);
+    EXPECT_EQ(before.workspaces[i].active_leaf,
+              after.workspaces[i].active_leaf);
+  }
+}
+
+TEST(WorkspaceLayoutModelTest, StructuralNavigationDoesNotActivatePages) {
+  auto model = Sample();
+  auto expected = model;
+  ASSERT_TRUE(model.SelectNode(N(6)));
+  ASSERT_TRUE(model.SelectParent());
+  EXPECT_EQ(model.workspaces[0].selected_node, N(4));
+  ASSERT_TRUE(model.SelectChild());
+  EXPECT_EQ(model.workspaces[0].selected_node, N(5));
+  EXPECT_FALSE(model.SelectChild());
+  ASSERT_TRUE(model.SelectNode(N(7)));  // Hidden structural selection is legal.
+  EXPECT_EQ(model.ResolveLayoutTarget(), N(3));
+  ASSERT_TRUE(model.SelectParent());
+  EXPECT_EQ(model.ResolveLayoutTarget(), N(3));
+  ASSERT_TRUE(model.SelectParent());
+  EXPECT_FALSE(model.SelectParent());
+  expected.workspaces[0].selected_node = N(1);
+  ExpectSameState(expected, model);
+  EXPECT_TRUE(model.Validate());
+}
