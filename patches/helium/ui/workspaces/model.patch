+  ASSERT_TRUE(model.SetLayout(LayoutKind::kTabbed, ids));
+  ASSERT_TRUE(model.SetSelectedChild(N(1), N(2)));
+  EXPECT_EQ(model.workspaces[0].active_leaf, N(2));
+  ASSERT_TRUE(model.SetSelectedChild(N(1), N(3)));
+  EXPECT_EQ(model.workspaces[0].active_leaf, N(5));
+  EXPECT_EQ(model.workspaces[0].selected_node, N(3));
+  EXPECT_EQ(Container(model, 3).selected_child, N(4));
+  EXPECT_EQ(Container(model, 4).layout, LayoutKind::kVertical);
+  EXPECT_EQ(Container(model, 4).children, (std::vector<NodeId>{N(5), N(6)}));
+  ASSERT_TRUE(model.SetSelectedChild(N(4), N(6)));
+  EXPECT_EQ(model.workspaces[0].active_leaf, N(6));
+  EXPECT_EQ(Container(model, 1).last_focused_leaf, N(6));
+  ASSERT_TRUE(model.SetSelectedChild(N(1), N(3)));
+  EXPECT_EQ(model.workspaces[0].active_leaf, N(6));
+  ExpectSameTopology(topology, model);
+  EXPECT_TRUE(model.Validate());
+}
