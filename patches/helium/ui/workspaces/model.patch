+TEST(WorkspaceLayoutModelTest, RefilledShellDoesNotRecycleRemovedNodeIds) {
+  WorkspaceLayoutModel model;
+  NodeId::Generator nodes;
+  WorkspaceId::Generator workspaces;
+  ASSERT_TRUE(model.CreateWorkspace(T(1), workspaces, nodes));
+  NodeId old_leaf = model.workspaces[0].active_leaf;
+  ASSERT_TRUE(model.RemoveConfirmedTab(T(1)));
+  ASSERT_TRUE(model.SwitchWorkspace(W(1)));
+  EXPECT_TRUE(model.nodes.empty());  // No speculative blank-tab ownership.
+  ASSERT_TRUE(model.InsertTab(T(2), {}, OpenDisposition::kBackground, nodes));
+  EXPECT_NE(model.workspaces[0].active_leaf, old_leaf);
+  EXPECT_TRUE(model.Validate());
+}
