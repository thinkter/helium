+#ifndef CHROME_BROWSER_UI_HELIUM_WORKSPACES_WORKSPACE_LAYOUT_MODEL_H_
+#define CHROME_BROWSER_UI_HELIUM_WORKSPACES_WORKSPACE_LAYOUT_MODEL_H_
+
+#include <map>
+#include <variant>
+#include <vector>
+
+#include "base/types/id_type.h"
+
+namespace helium::workspaces {
+
+using NodeId = base::IdTypeU64<class NodeIdTag>;
+using WorkspaceId = base::IdTypeU64<class WorkspaceIdTag>;
+// Opaque runtime association, not a strip index or a session identifier. The
+// controller will map these keys to tabs::TabHandle and resolve contents there.
+// Allocate IDs monotonically with their Generator; never recycle removed IDs.
+using TabKey = base::IdTypeU64<class TabKeyTag>;
+
+// Horizontal means side-by-side; vertical means top-to-bottom.
+enum class LayoutKind { kHorizontal, kVertical, kTabbed };
+
+enum class OpenDisposition { kForeground, kBackground };
+
+struct LeafState {
+  TabKey tab;
+};
+
+struct ContainerState {
+  LayoutKind layout = LayoutKind::kTabbed;
+  std::vector<NodeId> children;
+  NodeId selected_child;
+  // Positive finite relative weights, one per child, retained in tabbed mode.
+  // They need not sum to one; consumers must normalize without overflowing.
+  std::vector<double> split_weights;
+  NodeId last_focused_leaf;
+};
+
+using NodeState = std::variant<LeafState, ContainerState>;
+
+struct WorkspaceState {
+  WorkspaceId id;
+  NodeId root;
+  // Structural selection is independent of the browser command target.
+  NodeId selected_node;
+  // Also remembers this workspace's last active page while it is inactive.
+  NodeId active_leaf;
+};
+
+// Pure value state: no browser objects, ownership, geometry or persistence.
+// IDs survive copies and layout changes. Public fields allow constructing and
+// validating candidate states before a future mutation boundary commits them.
+// No topology serialization is provided; a future adapter needs its own schema.
+struct WorkspaceLayoutModel {
+  std::map<NodeId, NodeState> nodes;
+  std::vector<WorkspaceState> workspaces;
+  WorkspaceId active_workspace;
+
+  // Validates the complete forest, including inactive/hidden subtrees. Empty
+  // workspace shells have null root/selection/active IDs. An empty model has
+  // no active workspace. Nonempty workspaces have a visible active leaf and
+  // every container remembers a descendant leaf. Does not resolve live tabs;
+  // the controller must additionally verify coverage of its managed tab set.
+  bool Validate() const;
+
+  // Create and activate a workspace with an already-created tab association.
+  // A null tab creates an empty shell; switching to a shell never creates tabs.
+  // The controller supplies a blank tab via InsertTab after browser insertion.
+  // Generators live outside snapshots and must never recycle removed IDs.
+  WorkspaceId CreateWorkspace(TabKey initial_tab,
+                              WorkspaceId::Generator& workspace_ids,
+                              NodeId::Generator& node_ids);
+  bool SwitchWorkspace(WorkspaceId workspace);
+
+  // Wrap exactly this leaf in a new split, retaining its old parent's weight.
+  // The supplied new association becomes active (and structurally selected).
+  bool SplitLeaf(NodeId leaf,
+                 LayoutKind layout,
+                 TabKey new_tab,
+                 NodeId::Generator& node_ids);
+  // Insert after a known opener in its immediate container/workspace; otherwise
+  // after the active page. Singleton roots gain a tabbed container. Background
+  // opens retain workspace, active page and structural selection (except an
+  // empty shell needs an initial active/selected leaf). Existing weights stay
+  // unchanged; the inserted sibling gets its anchor's relative weight.
+  bool InsertTab(TabKey tab,
+                 TabKey opener,
+                 OpenDisposition disposition,
+                 NodeId::Generator& node_ids);
+  // Global strip selection reveals the workspace and all tabbed ancestors.
+  bool RevealTab(TabKey tab);
+  // Only call after actual removal/detach confirmation, NEVER on close request.
+  // Remove empty ancestors, retain meaningful unary containers and shells.
+  // Repair to the next sibling (previous at end), retaining surviving weights.
+  bool RemoveConfirmedTab(TabKey tab);
+
+  // These structural mutations affect only the active workspace. Invalid
+  // input/state or a missing target returns false without changing the model.
+  // Successful no-ops return true. Structural navigation never activates a
+  // different page.
+  bool SelectNode(NodeId node);
+  bool SelectParent();
+  bool SelectChild();  // Descend to the selected container's remembered child.
+
+  // Container selection targets itself; leaf selection targets its parent.
+  // A singleton leaf root targets itself and is wrapped by SetLayout(). Null
+  // means there is no target (empty workspace/model or invalid state).
+  NodeId ResolveLayoutTarget() const;
+  // Keep this generator outside model snapshots and never recycle its IDs.
+  // Only singleton-root wrapping consumes IDs; existing IDs are skipped.
+  bool SetLayout(LayoutKind layout, NodeId::Generator& node_ids);
+
+  // Explicit child activation (e.g. a tabbed header), unlike SelectChild().
+  // Preserve the active page if already in this child; otherwise restore its
+  // remembered leaf and reveal that path, including tabbed ancestors.
+  // Structural selection becomes the child; topology, order and weights stay
+  // unchanged.
+  bool SetSelectedChild(NodeId container, NodeId child);
+};
