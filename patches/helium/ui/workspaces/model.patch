+  ASSERT_TRUE(model.RevealTab(T(4)));
+  ASSERT_TRUE(model.SwitchWorkspace(W(2)));
+  const auto before = model;
+  ASSERT_TRUE(model.RevealTab(T(3)));
+  EXPECT_EQ(model.active_workspace, W(1));
+  EXPECT_EQ(model.workspaces[0].active_leaf, N(6));
+  EXPECT_EQ(model.workspaces[0].selected_node, N(6));
+  for (unsigned id : {1, 3, 4}) {
+    EXPECT_EQ(Container(model, id).last_focused_leaf, N(6));
+  }
+  EXPECT_EQ(Container(model, 1).selected_child, N(3));
+  EXPECT_EQ(Container(model, 3).selected_child, N(4));
+  EXPECT_EQ(Container(model, 4).selected_child, N(6));
+  auto topology = before;
+  topology.active_workspace = W(1);
+  ExpectSameTopology(topology, model);
+  EXPECT_TRUE(model.Validate());
+}
