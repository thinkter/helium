+namespace helium::workspaces {
+namespace {
+
+WorkspaceState* ActiveWorkspace(WorkspaceLayoutModel& model) {
+  for (auto& workspace : model.workspaces) {
+    if (workspace.id == model.active_workspace) {
+      return &workspace;
+    }
+  }
+  return nullptr;
+}
+
+// Call only on a validated forest. Derive parent links rather than storing a
+// second copy of topology in the model.
+NodeId Parent(const WorkspaceLayoutModel& model, NodeId child) {
+  for (const auto& [id, node] : model.nodes) {
+    const auto* container = std::get_if<ContainerState>(&node);
+    if (container && std::ranges::contains(container->children, child)) {
+      return id;
+    }
+  }
+  return {};
+}
+
+bool Contains(const WorkspaceLayoutModel& model, NodeId root, NodeId node) {
+  while (node) {
+    if (node == root) {
+      return true;
+    }
+    node = Parent(model, node);
+  }
+  return false;
+}
+
+NodeId FindTab(const WorkspaceLayoutModel& model, TabKey tab) {
+  for (const auto& [id, node] : model.nodes) {
+    const auto* leaf = std::get_if<LeafState>(&node);
+    if (leaf && leaf->tab == tab) {
+      return id;
+    }
+  }
+  return {};
+}
+
+NodeId AllocateNode(const WorkspaceLayoutModel& model,
+                    NodeId::Generator& node_ids) {
+  NodeId id;
+  do {
+    id = node_ids.GenerateNextId();
+  } while (model.nodes.contains(id));
+  return id;
+}
+
+NodeId RememberedLeaf(const WorkspaceLayoutModel& model, NodeId node) {
+  const auto* container = std::get_if<ContainerState>(&model.nodes.at(node));
+  return container ? container->last_focused_leaf : node;
+}
+
+void RevealLeaf(WorkspaceLayoutModel& model, NodeId leaf) {
+  for (NodeId child = leaf, parent = Parent(model, child); parent;
+       child = parent, parent = Parent(model, parent)) {
+    auto& container = std::get<ContainerState>(model.nodes.at(parent));
+    container.selected_child = child;
+    container.last_focused_leaf = leaf;
+  }
+}
+
+}  // namespace
+
+WorkspaceId WorkspaceLayoutModel::CreateWorkspace(
+    TabKey initial_tab,
+    WorkspaceId::Generator& workspace_ids,
+    NodeId::Generator& node_ids) {
+  if (!Validate() || (initial_tab && FindTab(*this, initial_tab))) {
+    return {};
+  }
+  auto candidate = *this;
+  WorkspaceId id;
+  do {
+    id = workspace_ids.GenerateNextId();
+  } while (std::ranges::any_of(
+      workspaces, [id](const auto& workspace) { return workspace.id == id; }));
+  NodeId leaf;
+  if (initial_tab) {
+    leaf = AllocateNode(candidate, node_ids);
+    candidate.nodes.emplace(leaf, LeafState{initial_tab});
+  }
+  candidate.workspaces.push_back({id, leaf, leaf, leaf});
+  candidate.active_workspace = id;
+  if (!candidate.Validate()) {
+    return {};
+  }
+  *this = std::move(candidate);
+  return id;
+}
+
+bool WorkspaceLayoutModel::SwitchWorkspace(WorkspaceId id) {
+  if (!Validate() ||
+      !std::ranges::any_of(workspaces, [id](const auto& workspace) {
+        return workspace.id == id;
+      })) {
+    return false;
+  }
+  // Each workspace already retains a visible active leaf and independent
+  // structural selection. In particular, switching to a shell is pure state.
+  active_workspace = id;
+  return true;
+}
+
+bool WorkspaceLayoutModel::RevealTab(TabKey tab) {
+  if (!Validate()) {
+    return false;
+  }
+  NodeId leaf = FindTab(*this, tab);
+  if (!leaf) {
+    return false;
+  }
+  auto candidate = *this;
+  for (auto& workspace : candidate.workspaces) {
+    if (Contains(candidate, workspace.root, leaf)) {
+      candidate.active_workspace = workspace.id;
+      workspace.active_leaf = leaf;
+      workspace.selected_node = leaf;
+      break;
+    }
+  }
+  RevealLeaf(candidate, leaf);
+  if (!candidate.Validate()) {
+    return false;
+  }
+  *this = std::move(candidate);
+  return true;
+}
+
+bool WorkspaceLayoutModel::SplitLeaf(NodeId leaf,
+                                     LayoutKind layout,
+                                     TabKey new_tab,
+                                     NodeId::Generator& node_ids) {
+  if (!Validate() || !new_tab || FindTab(*this, new_tab) ||
+      !nodes.contains(leaf) ||
+      !std::holds_alternative<LeafState>(nodes.at(leaf)) ||
+      (layout != LayoutKind::kHorizontal && layout != LayoutKind::kVertical)) {
+    return false;
+  }
+  auto candidate = *this;
+  NodeId parent = Parent(candidate, leaf);
+  NodeId added = AllocateNode(candidate, node_ids);
+  candidate.nodes.emplace(added, LeafState{new_tab});
+  NodeId wrapper = AllocateNode(candidate, node_ids);
+  candidate.nodes.emplace(
+      wrapper, ContainerState{layout, {leaf, added}, added, {1, 1}, added});
+  if (parent) {
+    auto& container = std::get<ContainerState>(candidate.nodes.at(parent));
+    std::ranges::replace(container.children, leaf, wrapper);
+    if (container.selected_child == leaf) {
+      container.selected_child = wrapper;
+    }
+  } else {
+    for (auto& workspace : candidate.workspaces) {
+      if (workspace.root == leaf) {
+        workspace.root = wrapper;
+        break;
+      }
+    }
+  }
+  // RevealTab validates its input, so establish the new active path directly.
+  for (auto& workspace : candidate.workspaces) {
+    if (Contains(candidate, workspace.root, added)) {
+      candidate.active_workspace = workspace.id;
+      workspace.active_leaf = added;
+      workspace.selected_node = added;
+      break;
+    }
+  }
+  RevealLeaf(candidate, added);
+  if (!candidate.Validate()) {
+    return false;
+  }
+  *this = std::move(candidate);
+  return true;
+}
+
+bool WorkspaceLayoutModel::InsertTab(TabKey tab,
+                                     TabKey opener,
+                                     OpenDisposition disposition,
+                                     NodeId::Generator& node_ids) {
+  if (!Validate() || !tab || FindTab(*this, tab) || workspaces.empty() ||
+      (disposition != OpenDisposition::kForeground &&
+       disposition != OpenDisposition::kBackground)) {
+    return false;
+  }
+  auto candidate = *this;
+  NodeId anchor = FindTab(candidate, opener);
+  auto* workspace = ActiveWorkspace(candidate);
+  if (anchor) {
+    for (auto& entry : candidate.workspaces) {
+      if (Contains(candidate, entry.root, anchor)) {
+        workspace = &entry;
+        break;
+      }
+    }
+  } else {
+    anchor = workspace->active_leaf;
+  }
+  NodeId added = AllocateNode(candidate, node_ids);
+  candidate.nodes.emplace(added, LeafState{tab});
+  if (!anchor) {
+    workspace->root = added;
+    workspace->active_leaf = added;
+    workspace->selected_node = added;
+  } else if (NodeId parent = Parent(candidate, anchor)) {
+    auto& container = std::get<ContainerState>(candidate.nodes.at(parent));
+    size_t index = std::ranges::find(container.children, anchor) -
+                   container.children.begin();
+    double weight = container.split_weights[index];
+    container.children.insert(container.children.begin() + index + 1, added);
+    container.split_weights.insert(container.split_weights.begin() + index + 1,
+                                   weight);
+  } else {
+    NodeId wrapper = AllocateNode(candidate, node_ids);
+    candidate.nodes.emplace(
+        wrapper,
+        ContainerState{
+            LayoutKind::kTabbed, {anchor, added}, anchor, {1, 1}, anchor});
+    workspace->root = wrapper;
+  }
+  if (disposition == OpenDisposition::kForeground) {
+    candidate.active_workspace = workspace->id;
+    workspace->active_leaf = added;
+    workspace->selected_node = added;
+    RevealLeaf(candidate, added);
+  }
+  if (!candidate.Validate()) {
+    return false;
+  }
+  *this = std::move(candidate);
+  return true;
+}
+
+bool WorkspaceLayoutModel::RemoveConfirmedTab(TabKey tab) {
+  if (!Validate()) {
+    return false;
+  }
+  NodeId leaf = FindTab(*this, tab);
+  if (!leaf) {
+    return false;
+  }
+  auto candidate = *this;
+  WorkspaceState* workspace = nullptr;
+  for (auto& entry : candidate.workspaces) {
+    if (Contains(candidate, entry.root, leaf)) {
+      workspace = &entry;
+      break;
+    }
+  }
+  NodeId removed = leaf;
+  NodeId surviving_parent;
+  while (removed) {
+    NodeId parent = Parent(candidate, removed);
+    candidate.nodes.erase(removed);
+    if (!parent) {
+      workspace->root = {};
+      workspace->active_leaf = {};
+      workspace->selected_node = {};
+      break;
+    }
+    auto& container = std::get<ContainerState>(candidate.nodes.at(parent));
+    size_t index = std::ranges::find(container.children, removed) -
+                   container.children.begin();
+    container.children.erase(container.children.begin() + index);
+    container.split_weights.erase(container.split_weights.begin() + index);
+    if (container.children.empty()) {
+      removed = parent;
+      continue;
+    }
+    if (container.selected_child == removed) {
+      container.selected_child =
+          container.children[std::min(index, container.children.size() - 1)];
+    }
+    surviving_parent = parent;
+    break;
+  }
+  // Only ancestors of the removed leaf can have stale focus. Repair bottom-up
+  // so a parent's fallback can use its selected child's repaired history.
+  for (NodeId id = surviving_parent; id; id = Parent(candidate, id)) {
+    auto& container = std::get<ContainerState>(candidate.nodes.at(id));
+    if (container.last_focused_leaf == leaf) {
+      container.last_focused_leaf =
+          RememberedLeaf(candidate, container.selected_child);
+    }
+  }
+  if (workspace->root) {
+    if (workspace->active_leaf == leaf) {
+      workspace->active_leaf = RememberedLeaf(candidate, surviving_parent);
+      RevealLeaf(candidate, workspace->active_leaf);
+    }
+    if (!candidate.nodes.contains(workspace->selected_node)) {
+      workspace->selected_node = workspace->active_leaf;
+    }
+  }
+  if (!candidate.Validate()) {
+    return false;
+  }
+  *this = std::move(candidate);
+  return true;
+}
+
+bool WorkspaceLayoutModel::SelectNode(NodeId node) {
+  if (!Validate()) {
+    return false;
+  }
+  auto* workspace = ActiveWorkspace(*this);
+  if (!workspace || !Contains(*this, workspace->root, node)) {
+    return false;
+  }
+  workspace->selected_node = node;
+  return true;
+}
+
+bool WorkspaceLayoutModel::SelectParent() {
+  if (!Validate()) {
+    return false;
+  }
+  const auto* workspace = ActiveWorkspace(*this);
+  return workspace && SelectNode(Parent(*this, workspace->selected_node));
+}
+
+bool WorkspaceLayoutModel::SelectChild() {
+  if (!Validate()) {
+    return false;
+  }
+  const auto* workspace = ActiveWorkspace(*this);
+  if (!workspace || !workspace->selected_node) {
+    return false;
+  }
+  const auto* container =
+      std::get_if<ContainerState>(&nodes.at(workspace->selected_node));
+  return container && SelectNode(container->selected_child);
+}
+
+NodeId WorkspaceLayoutModel::ResolveLayoutTarget() const {
+  if (!Validate()) {
+    return {};
+  }
+  for (const auto& workspace : workspaces) {
+    if (workspace.id != active_workspace || !workspace.selected_node) {
+      continue;
+    }
+    NodeId selected = workspace.selected_node;
+    if (std::holds_alternative<ContainerState>(nodes.at(selected))) {
+      return selected;
+    }
+    NodeId parent = Parent(*this, selected);
+    return parent ? parent : selected;
+  }
+  return {};
+}
+
+bool WorkspaceLayoutModel::SetLayout(LayoutKind layout,
+                                     NodeId::Generator& node_ids) {
+  switch (layout) {
+    case LayoutKind::kHorizontal:
+    case LayoutKind::kVertical:
+    case LayoutKind::kTabbed:
+      break;
+    default:
+      return false;
+  }
+  NodeId target = ResolveLayoutTarget();
+  if (!target) {
+    return false;
+  }
+  auto candidate = *this;
+  auto* workspace = ActiveWorkspace(candidate);
+  if (auto* container =
+          std::get_if<ContainerState>(&candidate.nodes.at(target))) {
+    container->layout = layout;
+    // Converting a split must not hide its active page. Hidden targets keep
+    // their remembered child; changing their layout does not activate them.
+    if (layout == LayoutKind::kTabbed &&
+        Contains(candidate, target, workspace->active_leaf)) {
+      NodeId child = workspace->active_leaf;
+      while (Parent(candidate, child) != target) {
+        child = Parent(candidate, child);
+      }
+      container->selected_child = child;
+    }
+  } else {
+    NodeId wrapper;
+    do {
+      wrapper = node_ids.GenerateNextId();
+    } while (candidate.nodes.contains(wrapper));
+    candidate.nodes.emplace(
+        wrapper, ContainerState{layout, {target}, target, {1}, target});
+    workspace->root = wrapper;
+    workspace->selected_node = wrapper;
+  }
+  if (!candidate.Validate()) {
+    return false;
+  }
+  *this = std::move(candidate);
+  return true;
+}
+
+bool WorkspaceLayoutModel::SetSelectedChild(NodeId container_id, NodeId child) {
+  if (!Validate()) {
+    return false;
+  }
+  const auto* workspace = ActiveWorkspace(*this);
+  if (!workspace || !Contains(*this, workspace->root, container_id)) {
+    return false;
+  }
+  const auto* container = std::get_if<ContainerState>(&nodes.at(container_id));
+  if (!container || !std::ranges::contains(container->children, child)) {
+    return false;
+  }
+  auto candidate = *this;
+  auto* next_workspace = ActiveWorkspace(candidate);
+  NodeId leaf = workspace->active_leaf;
+  if (!Contains(candidate, child, leaf)) {
+    const auto* subtree = std::get_if<ContainerState>(&nodes.at(child));
+    leaf = subtree ? subtree->last_focused_leaf : child;
+  }
+  // Reveal the remembered leaf even if its historical path is now hidden.
+  for (NodeId descendant = leaf, parent = Parent(candidate, descendant); parent;
+       descendant = parent, parent = Parent(candidate, parent)) {
+    auto& ancestor = std::get<ContainerState>(candidate.nodes.at(parent));
+    ancestor.selected_child = descendant;
+    ancestor.last_focused_leaf = leaf;
+  }
+  next_workspace->active_leaf = leaf;
+  next_workspace->selected_node = child;
+  if (!candidate.Validate()) {
+    return false;
+  }
+  *this = std::move(candidate);
+  return true;
+}
+
+bool WorkspaceLayoutModel::Validate() const {
+  std::set<WorkspaceId> workspace_ids;
+  std::set<NodeId> visited;
+  std::set<TabKey> tabs;
+  std::map<NodeId, NodeId> parents;
+
+  for (const auto& workspace : workspaces) {
+    if (!workspace.id || !workspace_ids.insert(workspace.id).second) {
+      return false;
+    }
+    if (!workspace.root) {
+      if (workspace.selected_node || workspace.active_leaf) {
+        return false;
+      }
+      continue;
+    }
+
+    std::set<NodeId> members;
+    std::set<NodeId> visible_leaves;
+    // Iterative traversal rejects cycles/shared children without risking stack
+    // exhaustion on malformed or deeply nested input.
+    std::vector<std::pair<NodeId, bool>> pending = {{workspace.root, true}};
+    while (!pending.empty()) {
+      const auto [id, visible] = pending.back();
+      pending.pop_back();
+      const auto it = nodes.find(id);
+      if (!id || it == nodes.end() || !visited.insert(id).second) {
+        return false;
+      }
+      members.insert(id);
+      if (const auto* leaf = std::get_if<LeafState>(&it->second)) {
+        if (!leaf->tab || !tabs.insert(leaf->tab).second) {
+          return false;
+        }
+        if (visible) {
+          visible_leaves.insert(id);
+        }
+        continue;
+      }
+
+      const auto& container = std::get<ContainerState>(it->second);
+      switch (container.layout) {
+        case LayoutKind::kHorizontal:
+        case LayoutKind::kVertical:
+        case LayoutKind::kTabbed:
+          break;
+        default:
+          return false;
+      }
+      if (container.children.empty() ||
+          container.children.size() != container.split_weights.size() ||
+          !std::ranges::contains(container.children,
+                                 container.selected_child)) {
+        return false;
+      }
+      for (double weight : container.split_weights) {
+        if (!std::isfinite(weight) || weight <= 0) {
+          return false;
+        }
+      }
+      for (NodeId child : container.children) {
+        if (!parents.emplace(child, id).second) {
+          return false;
+        }
+        pending.emplace_back(
+            child, visible && (container.layout != LayoutKind::kTabbed ||
+                               child == container.selected_child));
+      }
+    }
+    if (!members.contains(workspace.selected_node) ||
+        !visible_leaves.contains(workspace.active_leaf)) {
+      return false;
+    }
+  }
+
+  if (visited.size() != nodes.size() ||
+      (workspaces.empty() ? !!active_workspace
+                          : !workspace_ids.contains(active_workspace))) {
+    return false;
+  }
+
+  // Traversal above established an acyclic forest. Check remembered focus even
+  // for hidden containers; it must name a leaf in that container's subtree.
+  for (const auto& [id, node] : nodes) {
+    const auto* container = std::get_if<ContainerState>(&node);
+    if (!container) {
+      continue;
+    }
+    auto focus = nodes.find(container->last_focused_leaf);
+    if (focus == nodes.end() ||
+        !std::holds_alternative<LeafState>(focus->second)) {
+      return false;
+    }
+    NodeId ancestor = focus->first;
+    while (ancestor != id) {
+      const auto parent = parents.find(ancestor);
+      if (parent == parents.end()) {
+        return false;
+      }
+      ancestor = parent->second;
+    }
+  }
+  return true;
+}
+
