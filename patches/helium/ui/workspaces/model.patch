+TEST(WorkspaceLayoutModelTest, MutationSequenceValidatesAfterEveryOperation) {
+  for (auto layout : {LayoutKind::kHorizontal, LayoutKind::kVertical}) {
+    WorkspaceLayoutModel model;
+    NodeId::Generator nodes;
+    WorkspaceId::Generator workspaces;
+    const std::vector<std::pair<const char*, std::function<bool()>>> steps = {
+        {"create",
+         [&] { return !!model.CreateWorkspace(T(1), workspaces, nodes); }},
+        {"split", [&] { return model.SplitLeaf(N(1), layout, T(2), nodes); }},
+        {"background",
+         [&] {
+           return model.InsertTab(T(3), T(1), OpenDisposition::kBackground,
+                                  nodes);
+         }},
+        {"other workspace",
+         [&] { return !!model.CreateWorkspace(T(4), workspaces, nodes); }},
+        {"external reveal", [&] { return model.RevealTab(T(3)); }},
+        {"remove active", [&] { return model.RemoveConfirmedTab(T(3)); }},
+        {"remove sibling", [&] { return model.RemoveConfirmedTab(T(1)); }},
+        {"empty first", [&] { return model.RemoveConfirmedTab(T(2)); }},
+        {"switch empty", [&] { return model.SwitchWorkspace(W(1)); }},
+        {"refill shell",
+         [&] {
+           return model.InsertTab(T(5), {}, OpenDisposition::kForeground,
+                                  nodes);
+         }},
+        {"empty inactive", [&] { return model.RemoveConfirmedTab(T(4)); }},
+        {"final confirmed removal",
+         [&] { return model.RemoveConfirmedTab(T(5)); }},
+    };
+    for (const auto& [name, operation] : steps) {
+      SCOPED_TRACE(name);
+      ASSERT_TRUE(operation());
+      ASSERT_TRUE(model.Validate());
+    }
+    EXPECT_TRUE(model.nodes.empty());
+    EXPECT_EQ(model.workspaces.size(), 2u);
+    EXPECT_EQ(model.active_workspace, W(1));
+  }
+}
+
+TEST(WorkspaceLayoutModelTest, AllRemovalOrdersRetainValidWorkspaceShells) {
+  std::array<unsigned, 6> order = {1, 2, 3, 4, 5, 6};
+  do {
+    auto model = Sample();
+    for (unsigned tab : order) {
+      SCOPED_TRACE(tab);
+      ASSERT_TRUE(model.RemoveConfirmedTab(T(tab)));
+      ASSERT_TRUE(model.Validate());
+    }
+    EXPECT_TRUE(model.nodes.empty());
+    EXPECT_EQ(model.workspaces.size(), 3u);
+    EXPECT_EQ(model.active_workspace, W(1));
+    for (const auto& workspace : model.workspaces) {
+      EXPECT_FALSE(workspace.root);
+      EXPECT_FALSE(workspace.active_leaf);
+      EXPECT_FALSE(workspace.selected_node);
+    }
+  } while (std::ranges::next_permutation(order).found);
+}
