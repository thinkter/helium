+TEST(WorkspaceLayoutGeometryTest, ExtremePositiveFiniteRelativeWeights) {
+  auto metrics = Metrics();
+  metrics.divider_size_dip = 0;
+  const double largest = std::numeric_limits<double>::max();
+  const double smallest = std::numeric_limits<double>::denorm_min();
+  for (auto weights :
+       {std::vector<double>{largest, largest, smallest}, {1, 1, smallest}}) {
+    auto geometry =
+        CalculateWorkspaceGeometry(Split(weights), 100, 10, metrics);
+    ExpectBounds(geometry, N(2), {0, 0, 45, 10});
+    ExpectBounds(geometry, N(3), {45, 0, 45, 10});
+    ExpectBounds(geometry, N(4), {90, 0, 10, 10});
+    ExpectPartition(geometry, 100, 10);
+  }
+  auto geometry = CalculateWorkspaceGeometry(
+      Split({smallest, smallest, smallest}), 103, 10, metrics);
+  ExpectBounds(geometry, N(2), {0, 0, 35, 10});
+  ExpectBounds(geometry, N(3), {35, 0, 34, 10});
+  ExpectBounds(geometry, N(4), {69, 0, 34, 10});
+}
