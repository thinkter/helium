+TEST(WorkspaceLayoutGeometryTest,
+     SeededWeightAndViewportSweepPartitionsExactly) {
+  std::mt19937 random(12345);
+  for (int iteration = 0; iteration < 500; ++iteration) {
+    std::vector<double> weights(1 + random() % 12);
+    for (double& weight : weights) {
+      weight = std::ldexp(1.0 + (random() % 100) / 100.0,
+                          static_cast<int>(random() % 2000) - 1000);
+    }
+    auto metrics = Metrics();
+    metrics.rtl = random() % 2;
+    metrics.device_scale_factor = 0.75 + (random() % 8) * 0.25;
+    int width = 1 + random() % 900;
+    int height = 1 + random() % 900;
+    auto geometry = CalculateWorkspaceGeometry(
+        Split(weights,
+              random() % 2 ? LayoutKind::kHorizontal : LayoutKind::kVertical),
+        width, height, metrics);
+    ExpectPartition(geometry, width, height);
+    if (!geometry.constrained) {
+      for (const auto& leaf : geometry.leaves) {
+        EXPECT_GE(leaf.bounds.width,
+                  std::ceil(10 * metrics.device_scale_factor));
+        EXPECT_GE(leaf.bounds.height,
+                  std::ceil(10 * metrics.device_scale_factor));
+      }
+    }
+  }
+}
