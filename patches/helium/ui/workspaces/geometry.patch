+#ifndef CHROME_BROWSER_UI_HELIUM_WORKSPACES_WORKSPACE_LAYOUT_GEOMETRY_H_
+#define CHROME_BROWSER_UI_HELIUM_WORKSPACES_WORKSPACE_LAYOUT_GEOMETRY_H_
+
+#include <cstddef>
+#include <cstdint>
+#include <set>
+#include <vector>
+
+#include "chrome/browser/ui/helium/workspaces/workspace_layout_model.h"
+
+namespace helium::workspaces {
+
+// Physical pixels, relative to the content viewport's top-left. The host owns
+// DIP conversion and outer chrome insets; no Views/browser dependencies here.
+struct LayoutRect {
+  int x = 0;
+  int y = 0;
+  int width = 0;
+  int height = 0;
+  bool operator==(const LayoutRect&) const = default;
+};
+
+struct LayoutMetrics {
+  int leaf_min_width_dip = 100;
+  int leaf_min_height_dip = 100;
+  int header_height_dip = 24;
+  int divider_size_dip = 4;
+  double device_scale_factor = 1;
+  // Mirror horizontal splits, not tree order or physical focus directions.
+  bool rtl = false;
+};
+
+struct LeafLayout {
+  NodeId node;
+  LayoutRect bounds;
+};
+struct HeaderLayout {
+  NodeId container;
+  LayoutRect bounds;
+};
+struct DividerLayout {
+  NodeId container;
+  // Divider between children[index] and children[index + 1] in tree order.
+  size_t index = 0;
+  LayoutRect bounds;
+};
+struct WorkspaceGeometry {
+  // False for invalid model/metrics or negative viewport dimensions.
+  bool valid = false;
+  bool constrained = false;
+  // Selected-child recursive minimum, saturated at INT_MAX + 1 (cannot fit
+  // any supported viewport). Hidden tabbed children do not contribute.
+  int64_t minimum_width = 0;
+  int64_t minimum_height = 0;
+  // Depth-first tree order, even in RTL. Only positive-area leaves appear.
+  std::vector<LeafLayout> leaves;
+  std::set<NodeId> displayed_leaves;
+  std::vector<HeaderLayout> headers;
+  std::vector<DividerLayout> dividers;
+};
+
+// Computes only the active workspace. Empty shells return valid empty output.
+// Metrics are rounded up to physical pixels once. Weighted splits honor child
+// minima by clamping and redistributing, then allocate fractional remainders
+// largest-first (tree-order ties). Never changes the model. If minima cannot
+// fit, project only the active leaf over the viewport, without
+// headers/dividers. A zero-area viewport has no displayed leaves, including
+// during fallback.
+WorkspaceGeometry CalculateWorkspaceGeometry(const WorkspaceLayoutModel& model,
+                                             int viewport_width,
+                                             int viewport_height,
+                                             const LayoutMetrics& metrics = {});
+
+enum class FocusDirection { kLeft, kRight, kUp, kDown };
+// Physical center half-plane; candidates with positive perpendicular overlap
+// rank before non-overlapping candidates, then squared center distance, then
+// tree order. No wrapping. Null for invalid output or a non-displayed source.
+NodeId FindDirectionalNeighbor(const WorkspaceGeometry& geometry,
+                               NodeId from,
+                               FocusDirection direction);
+
+}  // namespace helium::workspaces
+
+#endif  // CHROME_BROWSER_UI_HELIUM_WORKSPACES_WORKSPACE_LAYOUT_GEOMETRY_H_
