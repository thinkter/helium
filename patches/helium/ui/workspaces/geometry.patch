+
+constexpr int64_t kTooLarge = int64_t{std::numeric_limits<int>::max()} + 1;
+
+int64_t AddMinimum(int64_t a, int64_t b) {
+  return std::min(kTooLarge, a + b);
+}
+
+int64_t ToPixels(int dip, double scale) {
+  const long double pixels = std::ceil(static_cast<long double>(dip) * scale);
+  return pixels >= kTooLarge ? kTooLarge : static_cast<int64_t>(pixels);
+}
+
+struct Minimum {
+  int64_t width = 0;
+  int64_t height = 0;
+};
+
+// Clamp undersized weighted shares and redistribute their deficit among the
+// remaining children. Normalize by the largest still-free weight each pass:
+// even DBL_MAX sums and denormal relative weights are safe. Underflow to zero
+// is harmless: positive child minima clamp that share before redistribution.
+std::vector<int> Allocate(int total,
+                          const std::vector<double>& weights,
+                          const std::vector<int>& minima) {
+  std::vector<int> sizes(weights.size(), 0);
+  std::vector<size_t> free(weights.size());
+  std::iota(free.begin(), free.end(), 0);
+  int remaining = total;
+  while (!free.empty()) {
+    double largest = 0;
+    for (size_t i : free) {
+      largest = std::max(largest, weights[i]);
+    }
+    long double sum = 0;
+    for (size_t i : free) {
+      sum += static_cast<long double>(weights[i]) / largest;
+    }
+    std::vector<long double> shares(weights.size(), 0);
+    std::vector<size_t> clamped;
+    for (size_t i : free) {
+      shares[i] =
+          remaining * (static_cast<long double>(weights[i]) / largest) / sum;
+      if (shares[i] < minima[i]) {
+        clamped.push_back(i);
+      }
+    }
+    if (!clamped.empty()) {
+      for (size_t i : clamped) {
+        sizes[i] = minima[i];
+        remaining -= sizes[i];
+      }
+      std::erase_if(free, [&](size_t i) { return sizes[i] != 0; });
+      continue;
+    }
+
+    // Reserve minima first so accumulated floating-point error can never
+    // steal a minimum pixel from a later child. Floor the remaining shares,
+    // capping at the budget to guarantee exact integer conservation.
+    int remainder = remaining;
+    for (size_t i : free) {
+      sizes[i] = minima[i];
+      remainder -= sizes[i];
+    }
+    for (size_t i : free) {
+      const int extra = std::min(
+          remainder, static_cast<int>(std::floor(shares[i])) - minima[i]);
+      sizes[i] += extra;
+      remainder -= extra;
+    }
+    std::stable_sort(free.begin(), free.end(), [&](size_t a, size_t b) {
+      return shares[a] - std::floor(shares[a]) >
+             shares[b] - std::floor(shares[b]);
+    });
+    for (size_t i = 0; remainder > 0; ++i, --remainder) {
+      ++sizes[free[i % free.size()]];
+    }
+    break;
+  }
+  return sizes;
+}
+
+void AddLeaf(WorkspaceGeometry& result, NodeId node, LayoutRect bounds) {
+  if (bounds.width > 0 && bounds.height > 0) {
+    result.leaves.push_back({node, bounds});
+    result.displayed_leaves.insert(node);
+  }
+}
+
+}  // namespace
+
+WorkspaceGeometry CalculateWorkspaceGeometry(const WorkspaceLayoutModel& model,
+                                             int viewport_width,
+                                             int viewport_height,
+                                             const LayoutMetrics& metrics) {
+  WorkspaceGeometry result;
+  if (viewport_width < 0 || viewport_height < 0 ||
+      metrics.leaf_min_width_dip <= 0 || metrics.leaf_min_height_dip <= 0 ||
+      metrics.header_height_dip < 0 || metrics.divider_size_dip < 0 ||
+      !std::isfinite(metrics.device_scale_factor) ||
+      metrics.device_scale_factor <= 0 || !model.Validate()) {
+    return result;
+  }
+  result.valid = true;
+  const auto workspace = std::ranges::find(
+      model.workspaces, model.active_workspace, &WorkspaceState::id);
+  if (workspace == model.workspaces.end() || !workspace->root) {
+    return result;
+  }
+  const Minimum leaf_minimum = {
+      ToPixels(metrics.leaf_min_width_dip, metrics.device_scale_factor),
+      ToPixels(metrics.leaf_min_height_dip, metrics.device_scale_factor)};
+  const int64_t header =
+      ToPixels(metrics.header_height_dip, metrics.device_scale_factor);
+  const int64_t divider =
+      ToPixels(metrics.divider_size_dip, metrics.device_scale_factor);
+
+  // Iterative postorder: model depth does not consume the C++ call stack.
+  std::vector<NodeId> order{workspace->root};
+  for (size_t i = 0; i < order.size(); ++i) {
+    if (const auto* container =
+            std::get_if<ContainerState>(&model.nodes.at(order[i]))) {
+      if (container->layout == LayoutKind::kTabbed) {
+        order.push_back(container->selected_child);
+      } else {
+        order.insert(order.end(), container->children.begin(),
+                     container->children.end());
+      }
+    }
+  }
+  std::map<NodeId, Minimum> minima;
+  for (auto it = order.rbegin(); it != order.rend(); ++it) {
+    const auto* container = std::get_if<ContainerState>(&model.nodes.at(*it));
+    if (!container) {
+      minima[*it] = leaf_minimum;
+      continue;
+    }
+    Minimum minimum;
+    if (container->layout == LayoutKind::kTabbed) {
+      minimum = minima.at(container->selected_child);
+      minimum.height = AddMinimum(minimum.height, header);
+    } else {
+      const bool horizontal = container->layout == LayoutKind::kHorizontal;
+      for (size_t i = 0; i < container->children.size(); ++i) {
+        const Minimum child = minima.at(container->children[i]);
+        if (horizontal) {
+          minimum.width = AddMinimum(minimum.width, child.width);
+          minimum.width = AddMinimum(minimum.width, i ? divider : 0);
+          minimum.height = std::max(minimum.height, child.height);
+        } else {
+          minimum.height = AddMinimum(minimum.height, child.height);
+          minimum.height = AddMinimum(minimum.height, i ? divider : 0);
+          minimum.width = std::max(minimum.width, child.width);
+        }
+      }
+    }
+    minima[*it] = minimum;
+  }
+  result.minimum_width = minima.at(workspace->root).width;
+  result.minimum_height = minima.at(workspace->root).height;
+  const LayoutRect viewport{0, 0, viewport_width, viewport_height};
+  if (result.minimum_width > viewport_width ||
+      result.minimum_height > viewport_height) {
+    result.constrained = true;
+    AddLeaf(result, workspace->active_leaf, viewport);
+    return result;
+  }
+
+  std::vector<std::pair<NodeId, LayoutRect>> pending{
+      {workspace->root, viewport}};
+  while (!pending.empty()) {
+    const auto [node, bounds] = pending.back();
+    pending.pop_back();
+    const auto* container = std::get_if<ContainerState>(&model.nodes.at(node));
+    if (!container) {
+      AddLeaf(result, node, bounds);
+      continue;
+    }
+    if (container->layout == LayoutKind::kTabbed) {
+      const int height = static_cast<int>(header);
+      result.headers.push_back(
+          {node, {bounds.x, bounds.y, bounds.width, height}});
+      pending.push_back({container->selected_child,
+                         {bounds.x, bounds.y + height, bounds.width,
+                          bounds.height - height}});
+      continue;
+    }
+    const bool horizontal = container->layout == LayoutKind::kHorizontal;
+    // A unary split has no divider, even if its configured size cannot fit.
+    const int gap =
+        container->children.size() > 1 ? static_cast<int>(divider) : 0;
+    std::vector<int> child_minima;
+    for (NodeId child : container->children) {
+      const Minimum minimum = minima.at(child);
+      child_minima.push_back(
+          static_cast<int>(horizontal ? minimum.width : minimum.height));
+    }
+    const int total = (horizontal ? bounds.width : bounds.height) -
+                      gap * static_cast<int>(container->children.size() - 1);
+    const auto sizes = Allocate(total, container->split_weights, child_minima);
+    int offset = 0;
+    std::vector<std::pair<NodeId, LayoutRect>> children;
+    for (size_t i = 0; i < sizes.size(); ++i) {
+      LayoutRect child = bounds;
+      if (horizontal) {
+        child.x += metrics.rtl ? bounds.width - offset - sizes[i] : offset;
+        child.width = sizes[i];
+      } else {
+        child.y += offset;
+        child.height = sizes[i];
+      }
+      children.emplace_back(container->children[i], child);
+      offset += sizes[i];
+      if (i + 1 < sizes.size()) {
+        LayoutRect separator = bounds;
+        if (horizontal) {
+          separator.x += metrics.rtl ? bounds.width - offset - gap : offset;
+          separator.width = gap;
+        } else {
+          separator.y += offset;
+          separator.height = gap;
+        }
+        result.dividers.push_back({node, i, separator});
+        offset += gap;
+      }
+    }
+    pending.insert(pending.end(), children.rbegin(), children.rend());
+  }
+  return result;
+}
+
+NodeId FindDirectionalNeighbor(const WorkspaceGeometry& geometry,
+                               NodeId from,
+                               FocusDirection direction) {
+  if (!geometry.valid) {
+    return {};
+  }
+  const auto source =
+      std::ranges::find(geometry.leaves, from, &LeafLayout::node);
+  if (source == geometry.leaves.end()) {
+    return {};
+  }
+  const auto& a = source->bounds;
+  NodeId best;
+  bool best_overlap = false;
+  long double best_distance = 0;
+  for (const auto& leaf : geometry.leaves) {
+    const auto& b = leaf.bounds;
+    // Doubled centers avoid fractions and signed-int overflow.
+    const int64_t dx = 2 * (int64_t{b.x} - a.x) + b.width - a.width;
+    const int64_t dy = 2 * (int64_t{b.y} - a.y) + b.height - a.height;
+    bool horizontal;
+    switch (direction) {
+      case FocusDirection::kLeft:
+        if (dx >= 0) {
+          continue;
+        }
+        horizontal = true;
+        break;
+      case FocusDirection::kRight:
+        if (dx <= 0) {
+          continue;
+        }
+        horizontal = true;
+        break;
+      case FocusDirection::kUp:
+        if (dy >= 0) {
+          continue;
+        }
+        horizontal = false;
+        break;
+      case FocusDirection::kDown:
+        if (dy <= 0) {
+          continue;
+        }
+        horizontal = false;
+        break;
+      default:
+        return {};
+    }
+    const bool overlap =
+        horizontal
+            ? std::max(int64_t{a.y}, int64_t{b.y}) <
+                  std::min(int64_t{a.y} + a.height, int64_t{b.y} + b.height)
+            : std::max(int64_t{a.x}, int64_t{b.x}) <
+                  std::min(int64_t{a.x} + a.width, int64_t{b.x} + b.width);
+    const long double distance =
+        static_cast<long double>(dx) * dx + static_cast<long double>(dy) * dy;
+    if (!best || (overlap && !best_overlap) ||
+        (overlap == best_overlap && distance < best_distance)) {
+      best = leaf.node;
+      best_overlap = overlap;
+      best_distance = distance;
+    }
+  }
+  return best;
+}
+
