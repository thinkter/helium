+TEST(WorkspaceLayoutGeometryTest,
+     DirectionalFocusUsesPhysicalHalfPlanesNoWrap) {
+  auto geometry =
+      CalculateWorkspaceGeometry(Split({1, 1, 1}), 100, 20, Metrics());
+  EXPECT_EQ(FindDirectionalNeighbor(geometry, N(3), FocusDirection::kLeft),
+            N(2));
+  EXPECT_EQ(FindDirectionalNeighbor(geometry, N(3), FocusDirection::kRight),
+            N(4));
+  EXPECT_FALSE(FindDirectionalNeighbor(geometry, N(2), FocusDirection::kLeft));
+  EXPECT_FALSE(FindDirectionalNeighbor(geometry, N(2), FocusDirection::kUp));
+  EXPECT_FALSE(
+      FindDirectionalNeighbor(geometry, N(99), FocusDirection::kRight));
+  auto metrics = Metrics();
+  metrics.rtl = true;
+  geometry = CalculateWorkspaceGeometry(Split({1, 1, 1}), 100, 20, metrics);
+  EXPECT_EQ(FindDirectionalNeighbor(geometry, N(3), FocusDirection::kLeft),
+            N(4));
+  EXPECT_EQ(FindDirectionalNeighbor(geometry, N(3), FocusDirection::kRight),
+            N(2));
+  geometry = CalculateWorkspaceGeometry(Sample(), 124, 45, Metrics());
+  EXPECT_EQ(FindDirectionalNeighbor(geometry, N(5), FocusDirection::kDown),
+            N(6));
+  EXPECT_EQ(FindDirectionalNeighbor(geometry, N(6), FocusDirection::kUp), N(5));
+  EXPECT_FALSE(FindDirectionalNeighbor(geometry, N(7), FocusDirection::kRight));
+  geometry = CalculateWorkspaceGeometry(Sample(), 1, 1, Metrics());
+  EXPECT_FALSE(FindDirectionalNeighbor(geometry, N(5), FocusDirection::kRight));
+}
