+TEST(WorkspaceLayoutGeometryTest, StableRoundingOnBothAxesAndRTL) {
+  auto metrics = Metrics();
+  metrics.divider_size_dip = 0;
+  for (bool rtl : {false, true}) {
+    metrics.rtl = rtl;
+    for (auto kind : {LayoutKind::kHorizontal, LayoutKind::kVertical}) {
+      auto geometry =
+          CalculateWorkspaceGeometry(Split({1, 1, 1}, kind), 103, 103, metrics);
+      EXPECT_EQ(geometry.leaves[0].node, N(2));
+      EXPECT_EQ(geometry.leaves[1].node, N(3));
+      EXPECT_EQ(geometry.leaves[2].node, N(4));
+      if (kind == LayoutKind::kHorizontal) {
+        ExpectBounds(geometry, N(2), {rtl ? 68 : 0, 0, 35, 103});
+        ExpectBounds(geometry, N(3), {34 + !rtl, 0, 34, 103});
+      } else {
+        ExpectBounds(geometry, N(2), {0, 0, 103, 35});
+        ExpectBounds(geometry, N(3), {0, 35, 103, 34});
+      }
+      ExpectPartition(geometry, 103, 103);
+    }
+  }
+}
