+TEST(WorkspaceLayoutGeometryTest,
+     DirectionalOverlapPrecedesDistanceAndTiesUseTreeOrder) {
+  WorkspaceGeometry geometry;
+  geometry.valid = true;
+  // Touching perpendicular edges is not overlap. A more distant overlapping
+  // candidate wins; equal centers on the direction axis are outside the plane.
+  geometry.leaves = {{N(8), {0, 0, 10, 10}},
+                     {N(6), {10, 10, 10, 10}},
+                     {N(4), {40, 0, 10, 10}},
+                     {N(2), {0, 30, 10, 10}}};
+  EXPECT_EQ(FindDirectionalNeighbor(geometry, N(8), FocusDirection::kRight),
+            N(4));
+  geometry.leaves = {{N(8), {0, 10, 10, 20}},
+                     {N(6), {20, 0, 10, 20}},
+                     {N(4), {20, 20, 10, 20}}};
+  EXPECT_EQ(FindDirectionalNeighbor(geometry, N(8), FocusDirection::kRight),
+            N(6));
+  std::swap(geometry.leaves[1], geometry.leaves[2]);
+  EXPECT_EQ(FindDirectionalNeighbor(geometry, N(8), FocusDirection::kRight),
+            N(4));
+  geometry.leaves = {{N(8), {0, 0, 10, 10}},
+                     {N(6), {30, 20, 10, 10}},
+                     {N(4), {10, 20, 10, 10}}};
+  EXPECT_EQ(FindDirectionalNeighbor(geometry, N(8), FocusDirection::kRight),
+            N(4));
+  geometry.valid = false;
+  EXPECT_FALSE(FindDirectionalNeighbor(geometry, N(8), FocusDirection::kRight));
+}
