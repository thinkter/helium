+
+constexpr NodeId N(unsigned value) {
+  return NodeId::FromUnsafeValue(value);
+}
+constexpr WorkspaceId W(unsigned value) {
+  return WorkspaceId::FromUnsafeValue(value);
+}
+constexpr TabKey T(unsigned value) {
+  return TabKey::FromUnsafeValue(value);
+}
+
+LayoutMetrics Metrics() {
+  return {10, 10, 3, 2, 1, false};
+}
+
+WorkspaceLayoutModel Sample() {
+  WorkspaceLayoutModel model;
+  model.nodes = {
+      {N(1),
+       ContainerState{
+           LayoutKind::kHorizontal, {N(2), N(3), N(8)}, N(3), {2, 3, 1}, N(5)}},
+      {N(2), LeafState{T(1)}},
+      {N(3),
+       ContainerState{LayoutKind::kTabbed, {N(4), N(7)}, N(4), {1, 2}, N(5)}},
+      {N(4),
+       ContainerState{LayoutKind::kVertical, {N(5), N(6)}, N(5), {1, 1}, N(5)}},
+      {N(5), LeafState{T(2)}},
+      {N(6), LeafState{T(3)}},
+      {N(7), LeafState{T(4)}},
+      {N(8), LeafState{T(5)}},
+      {N(9), LeafState{T(6)}}};
+  model.workspaces = {
+      {W(1), N(1), N(7), N(5)}, {W(2), N(9), N(9), N(9)}, {W(3), {}, {}, {}}};
+  model.active_workspace = W(1);
+  return model;
+}
+
+WorkspaceLayoutModel Split(std::vector<double> weights,
+                           LayoutKind kind = LayoutKind::kHorizontal) {
+  WorkspaceLayoutModel model;
+  ContainerState root{kind, {}, N(2), weights, N(2)};
+  for (unsigned i = 0; i < weights.size(); ++i) {
+    root.children.push_back(N(i + 2));
+    model.nodes.emplace(N(i + 2), LeafState{T(i + 1)});
+  }
+  model.nodes.emplace(N(1), std::move(root));
+  model.workspaces = {{W(1), N(1), N(1), N(2)}};
+  model.active_workspace = W(1);
+  return model;
+}
+
+void ExpectBounds(const WorkspaceGeometry& geometry,
+                  NodeId node,
+                  LayoutRect expected) {
+  auto it = std::ranges::find(geometry.leaves, node, &LeafLayout::node);
+  ASSERT_NE(it, geometry.leaves.end());
+  EXPECT_EQ(it->bounds, expected);
+}
+
+void ExpectPartition(const WorkspaceGeometry& geometry, int width, int height) {
+  ASSERT_TRUE(geometry.valid);
+  std::vector<LayoutRect> rectangles;
+  std::set<NodeId> displayed;
+  for (const auto& leaf : geometry.leaves) {
+    rectangles.push_back(leaf.bounds);
+    EXPECT_GT(leaf.bounds.width, 0);
+    EXPECT_GT(leaf.bounds.height, 0);
+    EXPECT_TRUE(displayed.insert(leaf.node).second);
+  }
+  EXPECT_EQ(displayed, geometry.displayed_leaves);
+  for (const auto& header : geometry.headers) {
+    rectangles.push_back(header.bounds);
+  }
+  for (const auto& divider : geometry.dividers) {
+    rectangles.push_back(divider.bounds);
+  }
+  int64_t area = 0;
+  for (size_t i = 0; i < rectangles.size(); ++i) {
+    const auto& a = rectangles[i];
+    EXPECT_GE(a.x, 0);
+    EXPECT_GE(a.y, 0);
+    EXPECT_GE(a.width, 0);
+    EXPECT_GE(a.height, 0);
+    EXPECT_LE(int64_t{a.x} + a.width, width);
+    EXPECT_LE(int64_t{a.y} + a.height, height);
+    area += int64_t{a.width} * a.height;
+    for (size_t j = 0; j < i; ++j) {
+      const auto& b = rectangles[j];
+      if (a.width && a.height && b.width && b.height) {
+        EXPECT_TRUE(a.x + a.width <= b.x || b.x + b.width <= a.x ||
+                    a.y + a.height <= b.y || b.y + b.height <= a.y);
+      }
+    }
+  }
+  EXPECT_EQ(area, int64_t{width} * height);
+}
+
+TEST(WorkspaceLayoutGeometryTest, MixedNestedLayoutAndExplicitDisplayedSet) {
+  const auto model = Sample();
+  ASSERT_TRUE(model.Validate());
+  auto geometry = CalculateWorkspaceGeometry(model, 124, 45, Metrics());
+  ASSERT_TRUE(geometry.valid);
+  EXPECT_FALSE(geometry.constrained);
+  EXPECT_EQ(geometry.minimum_width, 34);
+  EXPECT_EQ(geometry.minimum_height, 25);
+  EXPECT_EQ(geometry.displayed_leaves,
+            (std::set<NodeId>{N(2), N(5), N(6), N(8)}));
+  ExpectBounds(geometry, N(2), {0, 0, 40, 45});
+  ExpectBounds(geometry, N(5), {42, 3, 60, 20});
+  ExpectBounds(geometry, N(6), {42, 25, 60, 20});
+  ExpectBounds(geometry, N(8), {104, 0, 20, 45});
+  ASSERT_EQ(geometry.headers.size(), 1u);
+  EXPECT_EQ(geometry.headers[0].container, N(3));
+  EXPECT_EQ(geometry.headers[0].bounds, (LayoutRect{42, 0, 60, 3}));
+  ASSERT_EQ(geometry.dividers.size(), 3u);
+  EXPECT_EQ(geometry.dividers[0].container, N(1));
+  EXPECT_EQ(geometry.dividers[0].index, 0u);
+  EXPECT_EQ(geometry.dividers[0].bounds, (LayoutRect{40, 0, 2, 45}));
+  EXPECT_EQ(geometry.leaves[1].node, N(5));
+  ExpectPartition(geometry, 124, 45);
+}
+
+TEST(WorkspaceLayoutGeometryTest, ConstrainedUsesActiveNotHiddenSelection) {
+  auto model = Sample();
+  for (const auto size : {LayoutRect{0, 0, 33, 45},
+                          {0, 0, 124, 24},
+                          {0, 0, 1, 1},
+                          {0, 0, 0, 10},
+                          {0, 0, 10, 0}}) {
+    auto geometry =
+        CalculateWorkspaceGeometry(model, size.width, size.height, Metrics());
+    EXPECT_TRUE(geometry.constrained);
+    EXPECT_TRUE(geometry.headers.empty());
+    EXPECT_TRUE(geometry.dividers.empty());
+    if (size.width && size.height) {
+      EXPECT_EQ(geometry.displayed_leaves, (std::set<NodeId>{N(5)}));
+      ExpectBounds(geometry, N(5), size);
+    } else {
+      EXPECT_TRUE(geometry.displayed_leaves.empty());
+      EXPECT_TRUE(geometry.leaves.empty());
+    }
+    ExpectPartition(geometry, size.width, size.height);
+  }
+  EXPECT_TRUE(model.Validate());
+  EXPECT_EQ(model.nodes.size(), 9u);
+  EXPECT_EQ(model.workspaces[0].selected_node, N(7));
+  EXPECT_EQ(std::get<ContainerState>(model.nodes.at(N(1))).split_weights,
+            (std::vector<double>{2, 3, 1}));
+  EXPECT_FALSE(
+      CalculateWorkspaceGeometry(model, 34, 25, Metrics()).constrained);
+  EXPECT_EQ(CalculateWorkspaceGeometry(model, 124, 45, Metrics()).leaves.size(),
+            4u);
+}
+
+TEST(WorkspaceLayoutGeometryTest, TabbedMinimaFollowOnlySelectedSubtree) {
+  auto model = Sample();
+  ASSERT_TRUE(model.SetSelectedChild(N(3), N(7)));
+  auto geometry = CalculateWorkspaceGeometry(model, 34, 13, Metrics());
+  EXPECT_FALSE(geometry.constrained);
+  EXPECT_EQ(geometry.minimum_height, 13);
+  EXPECT_EQ(geometry.displayed_leaves, (std::set<NodeId>{N(2), N(7), N(8)}));
+  ExpectPartition(geometry, 34, 13);
+  ASSERT_TRUE(model.SetSelectedChild(N(3), N(4)));
+  EXPECT_TRUE(CalculateWorkspaceGeometry(model, 34, 13, Metrics()).constrained);
+}
