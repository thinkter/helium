+// static
+WorkspaceController* WorkspaceController::From(BrowserWindowInterface* window) {
+  return Get(window->GetUnownedUserDataHost());
+}
+
+WorkspaceController::StartResult WorkspaceController::StartTracking() {
+  if (!base::FeatureList::IsEnabled(kWorkspaceTabTracking) ||
+      !base::FeatureList::IsEnabled(kWorkspaceContentsHost)) {
+    return StartResult::kFeatureDisabled;
+  }
+  if (window_->GetType() != BrowserWindowInterface::TYPE_NORMAL) {
+    return StartResult::kUnsupportedWindow;
+  }
+  if (HasNativeSplit()) {
+    return StartResult::kNativeSplitPresent;
+  }
+  if (changing_tracking_ || stopping_tracking_ || presenting_host_ ||
+      activating_input_) {
+    return StartResult::kUnsupportedWindow;
+  }
+  if (is_tracking()) {
+    return StartResult::kStarted;
+  }
+
+  auto* strip = window_->GetTabStripModel();
+  // Do not detach the ordinary host for an empty window or an unlaid-out view.
+  if (!strip->GetActiveTab()) {
+    return StartResult::kUnsupportedWindow;
+  }
+  browser_view_ = BrowserView::GetBrowserViewForBrowser(
+      window_->GetBrowserForMigrationOnly());
+  if (!browser_view_ ||
+      browser_view_->contents_container()->bounds().IsEmpty()) {
+    browser_view_ = nullptr;
+    return StartResult::kUnsupportedWindow;
+  }
+  changing_tracking_ = true;
+  auto weak = lifetime_.GetWeakPtr();
+  base::ScopedClosureRunner finish(base::BindOnce(
+      [](base::WeakPtr<WorkspaceController> self) {
+        if (self) {
+          self->changing_tracking_ = false;
+        }
+      },
+      weak));
+  model_.CreateWorkspace(TabKey(), workspace_ids_, node_ids_);
+  TabKey previous;
+  for (int i = 0; i < strip->count(); ++i) {
+    const TabKey key = Associate(strip->GetTabAtIndex(i));
+    CHECK(model_.InsertTab(key, previous, OpenDisposition::kBackground,
+                           node_ids_));
+    previous = key;
+  }
+  if (auto* active = strip->GetActiveTab()) {
+    CHECK(model_.RevealTab(KeyForTab(active)));
+    // Even a singleton initial workspace has an explicit tabbed root.
+    CHECK(model_.SetLayout(LayoutKind::kTabbed, node_ids_));
+  }
+  strip->AddObserver(this);
+  tracking_ = true;
+  strip->SetDisplayedTabsProvider(base::BindRepeating(
+      [](base::WeakPtr<WorkspaceController> self) {
+        return self ? self->GetDisplayedTabs()
+                    : std::vector<tabs::TabInterface*>();
+      },
+      weak));
+  strip->SetDisplayedTabsLifecycle(
+      base::BindRepeating(&WorkspaceController::ReconcileTabStripChange, weak),
+      base::BindRepeating(&WorkspaceController::DetachConfirmedTab, weak));
+  const auto generation = ++generation_;
+  auto* host = browser_view_->InstallWorkspaceContentsView();
+  if (!weak) {
+    return StartResult::kUnsupportedWindow;
+  }
+  if (!tracking_ || generation_ != generation || !host) {
+    StopTracking();
+    return StartResult::kUnsupportedWindow;
+  }
+  workspace_host_ = host;
+  if (!PresentHost()) {
+    if (weak) {
+      StopTracking();
+    }
+    return StartResult::kUnsupportedWindow;
+  }
+  return StartResult::kStarted;
+}
+
+void WorkspaceController::StopTracking() {
+  if (stopping_tracking_) {
+    return;
+  }
+  // OnTabStripModelDestroyed may already have stopped observation. A later
+  // controller destructor must not fetch or clear a dead strip's policy.
+  if (!tracking_ && !browser_view_) {
+    activation_requests_.InvalidateWeakPtrs();
+    ++generation_;
+    return;
+  }
+  stopping_tracking_ = true;
+  CancelInput();
+  auto weak = lifetime_.GetWeakPtr();
+  activation_requests_.InvalidateWeakPtrs();
+  ++generation_;
+  auto* strip = window_->GetTabStripModel();
+  if (tracking_) {
+    std::vector<tabs::TabInterface*> destination;
+    if (auto* active = strip->GetActiveTab()) {
+      destination.push_back(active);
+      if (active->GetSplit()) {
+        destination = strip->GetSplitData(*active->GetSplit())->ListTabs();
+      }
+    }
+    strip->PrepareDisplayedTabsChange(destination);
+    if (!weak) {
+      return;
+    }
+  }
+  const bool was_tracking = std::exchange(tracking_, false);
+  auto* browser_view = browser_view_.get();
+  workspace_host_ = nullptr;
+  browser_view_ = nullptr;
+  // TabStripModelObserver owns its observation bookkeeping; ScopedObservation
+  // is explicitly forbidden by TabStripModel.
+  // Keep the provider installed (empty during reverse transfer), so policy
+  // cannot claim the ordinary host before it has actually been reattached.
+  strip->SetDisplayedTabsLifecycle({}, {});
+  StopObservingAll(this);
+  subscriptions_.clear();
+  tabs_.clear();
+  detaching_.clear();
+  displayed_keys_.clear();
+  model_ = WorkspaceLayoutModel();
+  // Clear policy and observation before callback-capable native teardown.
+  // Block nested StartTracking until the reverse transfer has completed.
+  const bool was_changing = std::exchange(changing_tracking_, true);
+  if (browser_view) {
+    browser_view->RemoveWorkspaceContentsView();
+  }
+  if (weak) {
+    if (was_tracking) {
+      strip->ClearDisplayedTabsProvider();
+    }
+    changing_tracking_ = was_changing;
+    stopping_tracking_ = false;
+  }
+  // Keep generators monotonic across re-enable, so stale IDs cannot alias.
+}
+
+bool WorkspaceController::RequestActivateTab(TabKey key,
+                                             uint64_t expected_generation) {
+  if (presenting_host_ || activating_input_ || changing_tracking_ ||
+      stopping_tracking_ || expected_generation != generation_ ||
+      !ResolveTab(key) || HasNativeSplit()) {
+    return false;
+  }
+  // A second accepted request supersedes the first, even in the same event
+  // turn. Weak lifetime and generation are independent guards: Stop/Start,
+  // removal, replacement and external selection must never revive old input.
+  CancelInput();
+  base::SingleThreadTaskRunner::GetCurrentDefault()->PostNonNestableTask(
+      FROM_HERE, base::BindOnce(&WorkspaceController::ActivateRequestedTab,
+                                activation_requests_.GetWeakPtr(), key,
+                                expected_generation));
+  return true;
+}
+
+void WorkspaceController::ActivateRequestedTab(TabKey key,
+                                               uint64_t expected_generation) {
+  if (expected_generation != generation_ || HasNativeSplit()) {
+    return;
+  }
+  auto* tab = ResolveTab(key);
+  if (!tab) {
+    return;
+  }
+  // Internal and external selection use the same model lifecycle hook. Native
+  // preparation computes and validates the destination exactly once, including
+  // DIP representability, before issuing any hide notifications.
+  // TabStripModel forbids reentrant mutations. Non-nestable dispatch prevents
+  // nested UI loops from activating before the focus/observer stack unwinds.
+  // Do not optimistically reveal a different page, and do not access this
+  // controller after activation: synchronous observers can stop tracking or
+  // destroy the window. The normal selection notification below commits the
+  // selected ancestor path. Nothing here may touch
+  // the controller after synchronous activation returns.
+  ActivateInputTab(tab);
+}
+
+void WorkspaceController::ActivateInputTab(tabs::TabInterface* tab) {
+  activating_input_ = true;
+  base::ScopedClosureRunner finish(base::BindOnce(
+      [](base::WeakPtr<WorkspaceController> self) {
+        if (self) {
+          self->activating_input_ = false;
+        }
+      },
+      lifetime_.GetWeakPtr()));
+  // Native focus from deactivate/activate observers cannot supersede the
+  // transaction or erase its pending structural-selection candidate.
+  window_->GetTabStripModel()->ActivateTab(tab);
+}
+
+LayoutMetrics WorkspaceController::CurrentMetrics() const {
+  LayoutMetrics metrics;
+  metrics.rtl = base::i18n::IsRTL();
+  if (workspace_host_ && workspace_host_->GetWidget()) {
+    if (auto* compositor = workspace_host_->GetWidget()->GetCompositor()) {
+      metrics.device_scale_factor = compositor->device_scale_factor();
+    }
+  }
+  return metrics;
+}
+
+void WorkspaceController::CancelInput() {
+  activation_requests_.InvalidateWeakPtrs();
+  resize_gesture_.reset();
+  header_destination_.reset();
+  if (workspace_host_) {
+    workspace_host_->CancelResize();
+  }
+}
+
+bool WorkspaceController::CanAcceptInput(uint64_t expected_generation) const {
+  if (!tracking_ || presenting_host_ || activating_input_ ||
+      changing_tracking_ || stopping_tracking_ ||
+      expected_generation != generation_ || !workspace_host_ ||
+      !browser_view_ || HasNativeSplit()) {
+    return false;
+  }
+  auto* widget = workspace_host_->GetWidget();
+  const auto metrics = CurrentMetrics();
+  return widget && widget->IsVisible() && widget->IsActive() &&
+         browser_view_->contents_container()->bounds() == presented_bounds_ &&
+         metrics.device_scale_factor ==
+             presented_metrics_.device_scale_factor &&
+         metrics.rtl == presented_metrics_.rtl;
+}
+
+bool WorkspaceController::RequestPaneFocus(
+    TabKey key,
+    base::WeakPtr<content::WebContents> contents,
+    uint64_t expected_generation) {
+  auto* tab = ResolveTab(key);
+  if (!CanAcceptInput(expected_generation) || !contents || !tab ||
+      tab->GetContents() != contents.get() ||
+      !workspace_host_->HasCommittedAttachment(key, contents.get())) {
+    return false;
+  }
+  CancelInput();
+  if (tab == window_->GetTabStripModel()->GetActiveTab()) {
+    return true;
+  }
+  // Retain neither the page nor the tab. Validate owner/handle/contents and
+  // actual committed membership again after leaving the native focus stack.
+  base::SingleThreadTaskRunner::GetCurrentDefault()->PostNonNestableTask(
+      FROM_HERE,
+      base::BindOnce(
+          [](base::WeakPtr<WorkspaceController> self, TabKey key,
+             tabs::TabHandle handle,
+             base::WeakPtr<content::WebContents> contents,
+             uint64_t generation) {
+            if (!self || !self->CanAcceptInput(generation) || !contents) {
+              return;
+            }
+            auto* tab = self->ResolveTab(key);
+            if (!tab || tab->GetHandle() != handle ||
+                tab->GetContents() != contents.get() ||
+                !self->workspace_host_->HasCommittedAttachment(
+                    key, contents.get())) {
+              return;
+            }
+            self->ActivateInputTab(tab);
+          },
+          activation_requests_.GetWeakPtr(), key, tab->GetHandle(), contents,
+          expected_generation));
+  return true;
+}
+
+bool WorkspaceController::RequestSelectChild(NodeId container,
+                                             NodeId child,
+                                             uint64_t expected_generation) {
+  if (!CanAcceptInput(expected_generation)) {
+    return false;
+  }
+  auto headers = workspace_host_->GetHeaders();
+  if (!std::ranges::any_of(headers, [&](auto* header) {
+        return header->container() == container &&
+               std::ranges::contains(header->child_ids(), child);
+      })) {
+    return false;
+  }
+  CancelInput();
+  base::SingleThreadTaskRunner::GetCurrentDefault()->PostNonNestableTask(
+      FROM_HERE, base::BindOnce(&WorkspaceController::SelectRequestedChild,
+                                activation_requests_.GetWeakPtr(), container,
+                                child, expected_generation));
+  return true;
+}
+
+void WorkspaceController::SelectRequestedChild(NodeId container,
+                                               NodeId child,
+                                               uint64_t expected_generation) {
+  if (!CanAcceptInput(expected_generation)) {
+    return;
+  }
+  auto candidate = model_;
+  if (!candidate.SetSelectedChild(container, child)) {
+    return;
+  }
+  auto workspace = std::ranges::find(
+      candidate.workspaces, candidate.active_workspace, &WorkspaceState::id);
+  if (workspace == candidate.workspaces.end() || !workspace->active_leaf) {
+    return;
+  }
+  const auto key =
+      std::get<LeafState>(candidate.nodes.at(workspace->active_leaf)).tab;
+  auto* tab = ResolveTab(key);
+  if (!tab) {
+    return;
+  }
+  if (window_->GetTabStripModel()->GetActiveTab() == tab) {
+    model_ = std::move(candidate);
+    ++generation_;
+    PresentHost();
+    return;
+  }
+  // Chromium selection remains authoritative. Consume the candidate only at
+  // its pre-observer lifecycle seam, preserving the selected subtree rather
+  // than replacing structural selection with its active descendant.
+  header_destination_ = std::move(candidate);
+  auto weak = lifetime_.GetWeakPtr();
+  ActivateInputTab(tab);
+  if (weak) {
+    header_destination_.reset();
+  }
+}
+
+bool WorkspaceController::RequestResize(WorkspaceResizeRequest request,
+                                        uint64_t expected_generation) {
+  if (!CanAcceptInput(expected_generation)) {
+    return false;
+  }
+  const auto dividers = workspace_host_->GetDividers();
+  if (!std::ranges::any_of(dividers, [&](auto* divider) {
+        return divider->target() == request.target;
+      })) {
+    return false;
+  }
+  if (request.cumulative) {
+    if (!resize_gesture_) {
+      resize_gesture_ = ResizeGesture{model_, request.target, presented_bounds_,
+                                      presented_metrics_};
+    }
+    if (resize_gesture_->target != request.target) {
+      return false;
+    }
+  } else if (resize_gesture_) {
+    return false;
+  }
+  auto candidate = request.cumulative ? resize_gesture_->baseline : model_;
+  const auto metrics =
+      request.cumulative ? resize_gesture_->metrics : presented_metrics_;
+  const auto bounds =
+      request.cumulative ? resize_gesture_->bounds : presented_bounds_;
+  const int width = std::round(bounds.width() * metrics.device_scale_factor);
+  const int height = std::round(bounds.height() * metrics.device_scale_factor);
+  if (!ResizeWorkspace(candidate, width, height, metrics, request.target,
+                       request.delta_pixels)) {
+    return false;
+  }
+  const auto geometry =
+      CalculateWorkspaceGeometry(candidate, width, height, metrics);
+  const auto split = std::ranges::find(
+      geometry.splits, request.target.container, &SplitLayout::container);
+  CHECK(split != geometry.splits.end());
+  const int committed_value = split->sizes[request.target.index];
+  activation_requests_.InvalidateWeakPtrs();
+  model_ = std::move(candidate);
+  if (request.last_update) {
+    resize_gesture_.reset();
+  }
+  // Weight-only commits do not invalidate the captured callback's generation.
+  // Every external topology/lifecycle/selection/viewport change does.
+  auto weak = lifetime_.GetWeakPtr();
+  if (!PresentHost() || !weak || !CanAcceptInput(expected_generation)) {
+    return false;
+  }
+  for (auto* divider : workspace_host_->GetDividers()) {
+    if (divider->target() == request.target) {
+      // Announce only after native and foreground publication succeeded, for
+      // keyboard/AX steps as well as pointer updates. No access after dispatch.
+      divider->UpdateValue(committed_value, true);
+      return true;
+    }
+  }
+  return false;
+}
+
+bool WorkspaceController::HasNativeSplit() const {
+  auto* strip = window_->GetTabStripModel();
+  for (int i = 0; i < strip->count(); ++i) {
+    if (strip->GetSplitForTab(i)) {
+      return true;
+    }
+  }
+  return false;
+}
+
+tabs::TabInterface* WorkspaceController::ResolveTab(TabKey key) const {
+  const auto it = tabs_.find(key);
+  if (!is_tracking() || it == tabs_.end() || detaching_.contains(key)) {
+    return nullptr;
+  }
+  auto* tab = it->second.Get();
+  if (!tab || tab->GetBrowserWindowInterface() != window_ ||
+      window_->GetTabStripModel()->GetIndexOfTab(tab) ==
+          TabStripModel::kNoTab) {
+    return nullptr;
+  }
+  return tab;
+}
+
+void WorkspaceController::OnHostWindowChanged() {
+  if (!tracking_ || stopping_tracking_) {
+    return;
+  }
+  CancelInput();
+  const auto generation = ++generation_;
+  // Do not transfer native attachments inside a Widget observer callback.
+  base::SingleThreadTaskRunner::GetCurrentDefault()->PostNonNestableTask(
+      FROM_HERE,
+      base::BindOnce(
+          [](base::WeakPtr<WorkspaceController> self, uint64_t generation) {
+            if (self && self->generation_ == generation) {
+              self->PresentHost();
+            }
+          },
+          lifetime_.GetWeakPtr(), generation));
+}
+
+void WorkspaceController::OnHostLayoutChanged() {
+  PresentHost();
+}
+
+bool WorkspaceController::PresentHost() {
+  if (!tracking_ || stopping_tracking_ || !browser_view_ || !workspace_host_ ||
+      presenting_host_) {
+    return false;
+  }
+  const auto bounds = browser_view_->contents_container()->bounds();
+  const auto metrics = CurrentMetrics();
+  if (bounds != presented_bounds_ ||
+      metrics.device_scale_factor != presented_metrics_.device_scale_factor ||
+      metrics.rtl != presented_metrics_.rtl) {
+    CancelInput();
+    ++generation_;
+  }
+  auto weak = lifetime_.GetWeakPtr();
+  presenting_host_ = true;
+  base::ScopedClosureRunner finish(base::BindOnce(
+      [](base::WeakPtr<WorkspaceController> self) {
+        if (self) {
+          self->presenting_host_ = false;
+        }
+      },
+      weak));
+  // Until rollback can preserve a previous multi-leaf attachment transaction,
+  // fail closed to Chromium's ordinary host, never leave stale foreground data
+  // describing a partially applied projection.
+  auto abort = [weak] {
+    if (weak && weak->tracking_) {
+      weak->StopTracking();
+    }
+    return false;
+  };
+  const auto generation = generation_;
+  auto* host = workspace_host_.get();
+  std::map<TabKey, content::WebContents*> bindings;
+  for (const auto& [key, handle] : tabs_) {
+    if (auto* tab = ResolveTab(key); tab && tab->GetContents()) {
+      bindings.emplace(key, tab->GetContents());
+    }
+  }
+  // The workspace is a BrowserView child; its current content-region bounds
+  // and scale were validated against any captured gesture before this pass.
+  // Present must never retain references to mutable controller policy across
+  // native attachment callbacks (which may stop tracking or mutate the strip).
+  const auto model = model_;
+  host->SetBoundsRect(bounds);
+  if (!weak || !tracking_ || generation_ != generation ||
+      workspace_host_ != host) {
+    return abort();
+  }
+  auto is_current = base::BindRepeating(
+      [](base::WeakPtr<WorkspaceController> self, uint64_t generation,
+         WorkspaceContentsView* host,
+         const std::map<TabKey, content::WebContents*>& bindings,
+         const gfx::Rect& bounds, const LayoutMetrics& metrics) {
+        if (!self || !self->tracking_ || self->generation_ != generation ||
+            self->workspace_host_ != host ||
+            self->browser_view_->contents_container()->bounds() != bounds ||
+            self->CurrentMetrics().device_scale_factor !=
+                metrics.device_scale_factor ||
+            self->CurrentMetrics().rtl != metrics.rtl) {
+          return false;
+        }
+        for (const auto& [key, contents] : bindings) {
+          auto* tab = self->ResolveTab(key);
+          if (!tab || tab->GetContents() != contents) {
+            return false;
+          }
+        }
+        return true;
+      },
+      weak, generation, host, bindings, bounds, metrics);
+  WorkspaceContentsView::InputCallbacks input;
+  input.focus = base::BindRepeating(
+      [](base::WeakPtr<WorkspaceController> self, uint64_t generation,
+         TabKey key, base::WeakPtr<content::WebContents> contents) {
+        if (self) {
+          self->RequestPaneFocus(key, contents, generation);
+        }
+      },
+      weak, generation);
+  input.select = base::BindRepeating(
+      [](base::WeakPtr<WorkspaceController> self, uint64_t generation,
+         NodeId container, NodeId child) {
+        if (self) {
+          self->RequestSelectChild(container, child, generation);
+        }
+      },
+      weak, generation);
+  input.resize = base::BindRepeating(
+      [](base::WeakPtr<WorkspaceController> self, uint64_t generation,
+         WorkspaceResizeRequest request) {
+        if (self) {
+          self->RequestResize(request, generation);
+        }
+      },
+      weak, generation);
+  if (bounds.IsEmpty() ||
+      !host->Present(
+          model, metrics, bindings, {}, std::move(is_current),
+          base::BindRepeating(&WorkspaceController::PrepareDisplayedTabs, weak),
+          std::move(input))) {
+    return abort();
+  }
+  if (!weak || !tracking_ || generation_ != generation ||
+      workspace_host_ != host) {
+    return abort();
+  }
+  presented_bounds_ = bounds;
+  presented_metrics_ = metrics;
+  SetDisplayedTabs(host->GetDisplayedTabKeys());
+  browser_view_->OnWorkspacePresentationCommitted();
+  return weak && tracking_ && generation_ == generation &&
+         workspace_host_ == host;
+}
+
+void WorkspaceController::SetDisplayedTabs(std::vector<TabKey> keys) {
+  if (!tracking_) {
+    return;
+  }
+  for (TabKey key : keys) {
+    if (!ResolveTab(key)) {
+      return;
+    }
+  }
+  // Only successful native commit publishes keys. The provider additionally
+  // checks actual attachments while a later transaction is in progress.
+  displayed_keys_ = std::move(keys);
+}
+
+std::vector<tabs::TabInterface*> WorkspaceController::GetDisplayedTabs() const {
+  std::vector<tabs::TabInterface*> displayed;
+  for (TabKey key : displayed_keys_) {
+    if (auto* tab = ResolveTab(key);
+        tab && workspace_host_ &&
+        workspace_host_->HasCommittedAttachment(key, tab->GetContents())) {
+      displayed.push_back(tab);
+    }
+  }
+  return displayed;
+}
+
+TabKey WorkspaceController::KeyForTab(const tabs::TabInterface* tab) const {
+  if (tab) {
+    for (const auto& [key, handle] : tabs_) {
+      if (handle == tab->GetHandle()) {
+        return key;
+      }
+    }
+  }
+  return TabKey();
+}
+
+TabKey WorkspaceController::Associate(tabs::TabInterface* tab) {
+  CHECK(!KeyForTab(tab));
+  const TabKey key = tab_ids_.GenerateNextId();
+  tabs_.emplace(key, tab->GetHandle());
+  auto& subscriptions = subscriptions_[key];
+  // Unretained is bounded by the owned subscriptions, cleared before teardown.
+  subscriptions.push_back(tab->RegisterWillDetach(base::BindRepeating(
+      &WorkspaceController::WillDetach, base::Unretained(this))));
+  subscriptions.push_back(tab->RegisterWillDiscardContents(base::BindRepeating(
+      &WorkspaceController::WillDiscard, base::Unretained(this))));
+  return key;
+}
+
+void WorkspaceController::WillDetach(tabs::TabInterface* tab,
+                                     tabs::TabInterface::DetachReason reason) {
+  // Invalidate in-flight requests, but retain the committed displayed set.
+  // Detach can be canceled (beforeunload) or become a cross-window move. Only
+  // the confirmed pre-removal hook retires attachments; kRemoved repairs the
+  // tree at the pre-Browser reconciliation boundary. Refresh callback epochs
+  // after this stack even if beforeunload later cancels without a strip change.
+  OnHostWindowChanged();
+}
+
+void WorkspaceController::WillDiscard(tabs::TabInterface* tab,
+                                      content::WebContents* old_contents,
+                                      content::WebContents* new_contents) {
+  // GetContents still refers to old_contents here. No attachments or pointer
+  // cache to update; kReplaced below is the post-swap notification.
+  OnHostWindowChanged();
+}
+
+void WorkspaceController::PrepareDisplayedTabs(
+    const std::vector<TabKey>& keys) {
+  std::vector<tabs::TabInterface*> destination;
+  for (auto key : keys) {
+    auto* tab = ResolveTab(key);
+    if (!tab) {
+      return;
+    }
+    destination.push_back(tab);
+  }
+  window_->GetTabStripModel()->PrepareDisplayedTabsChange(destination);
+}
+
+void WorkspaceController::DetachConfirmedTab(tabs::TabInterface* tab) {
+  const auto key = KeyForTab(tab);
+  if (!key || !workspace_host_) {
+    return;
+  }
+  CancelInput();
+  const auto generation = ++generation_;
+  auto weak = lifetime_.GetWeakPtr();
+  // Native detachment can request layout before kRemoved repairs the tree.
+  // Never let that callback re-present the still-associated outgoing leaf.
+  const bool was_presenting = std::exchange(presenting_host_, true);
+  base::ScopedClosureRunner finish(base::BindOnce(
+      [](base::WeakPtr<WorkspaceController> self, bool was_presenting) {
+        if (self) {
+          self->presenting_host_ = was_presenting;
+        }
+      },
+      weak, was_presenting));
+  auto destination = displayed_keys_;
+  std::erase(destination, key);
+  PrepareDisplayedTabs(destination);
+  if (!weak || !tracking_ || generation_ != generation || !workspace_host_) {
+    return;
+  }
+  detaching_.insert(key);
+  workspace_host_->DetachTab(key);
+  if (!weak || !tracking_ || generation_ != generation) {
+    return;
+  }
+  displayed_keys_ = std::move(destination);
+}
+
+void WorkspaceController::ReconcileTabStripChange(
+    const TabStripModelChange& change,
+    const TabStripSelectionChange& selection) {
+  if (!tracking_ || stopping_tracking_) {
+    return;
+  }
+  auto* strip = window_->GetTabStripModel();
+  if (HasNativeSplit()) {
+    StopTracking();
+    return;
+  }
+  auto header_destination = std::move(header_destination_);
+  CancelInput();
+  ++generation_;
+  switch (change.type()) {
+    case TabStripModelChange::kInserted:
+      for (const auto& inserted : change.GetInsert()->contents) {
+        auto* tab = inserted.tab.get();
+        const int index = strip->GetIndexOfTab(tab);
+        const TabKey opener = KeyForTab(strip->GetOpenerOfTabAt(index));
+        const TabKey key = Associate(tab);
+        // Chromium has already applied disposition to selection. Never infer
+        // foreground from multi-selection, insertion index, or opener alone.
+        CHECK(model_.InsertTab(key, opener,
+                               tab == selection.new_tab
+                                   ? OpenDisposition::kForeground
+                                   : OpenDisposition::kBackground,
+                               node_ids_));
+      }
+      break;
+    case TabStripModelChange::kRemoved:
+      for (const auto& removed : change.GetRemove()->contents) {
+        const TabKey key = KeyForTab(removed.tab);
+        CHECK(model_.RemoveConfirmedTab(key));
+        subscriptions_.erase(key);
+        detaching_.erase(key);
+        tabs_.erase(key);
+      }
+      break;
+    case TabStripModelChange::kReplaced:
+      // TabModel swaps contents, not its handle. Retain the leaf and resolve
+      // GetContents afresh; no remove/insert and no new association key.
+      CHECK(KeyForTab(change.GetReplace()->tab));
+      break;
+    case TabStripModelChange::kMoved:
+    case TabStripModelChange::kSelectionOnly:
+      break;
+  }
+  if (selection.new_tab && selection.active_tab_changed()) {
+    CHECK(model_.RevealTab(KeyForTab(selection.new_tab)));
+  }
+  if (header_destination &&
+      change.type() == TabStripModelChange::kSelectionOnly &&
+      selection.new_tab) {
+    const auto workspace = std::ranges::find(
+        header_destination->workspaces, header_destination->active_workspace,
+        &WorkspaceState::id);
+    if (workspace != header_destination->workspaces.end() &&
+        std::get<LeafState>(
+            header_destination->nodes.at(workspace->active_leaf))
+                .tab == KeyForTab(selection.new_tab)) {
+      model_ = std::move(*header_destination);
+    }
+  }
+  CHECK(model_.Validate());
+  if (tracking_) {
+    PresentHost();
+  }
+}
+
+void WorkspaceController::OnTabStripModelDestroyed(TabStripModel* strip) {
+  StopTracking();
+}
+
+void WorkspaceController::OnSplitTabChanged(const SplitTabChange& change) {
+  if (HasNativeSplit()) {
+    StopTracking();
+  }
+}
