+IN_PROC_BROWSER_TEST_F(WorkspaceControllerBrowserTest,
+                       ImportOpenerDispositionAndReplacement) {
+  auto* strip = browser()->tab_strip_model();
+  strip->InsertWebContentsAt(1, NewContents(browser()), 0);
+  strip->InsertWebContentsAt(2, NewContents(browser()), 0);
+  auto* controller = WorkspaceController::From(browser());
+  ASSERT_TRUE(controller);
+  EXPECT_FALSE(controller->is_tracking());
+  ASSERT_EQ(Result::kStarted, controller->StartTracking());
+  const auto& initial = controller->model();
+  ASSERT_TRUE(initial.Validate());
+  ASSERT_EQ(1u, initial.workspaces.size());
+  const NodeId root = initial.workspaces.front().root;
+  const auto children =
+      std::get<ContainerState>(initial.nodes.at(root)).children;
+  ASSERT_EQ(3u, children.size());
+  for (int i = 0; i < 3; ++i) {
+    EXPECT_EQ(controller->KeyForTab(strip->GetTabAtIndex(i)),
+              std::get<LeafState>(initial.nodes.at(children[i])).tab);
+  }
+  EXPECT_EQ(LayoutKind::kTabbed,
+            std::get<ContainerState>(initial.nodes.at(root)).layout);
+  const TabKey opener = ActiveKey(*controller);
+  // Deliberately insert at the strip end: policy order follows the opener,
+  // not the temporary strip index. Background open retains browser activation.
+  strip->InsertWebContentsAt(3, NewContents(browser()), ADD_INHERIT_OPENER);
+  const TabKey background = controller->KeyForTab(strip->GetTabAtIndex(3));
+  EXPECT_EQ(opener, ActiveKey(*controller));
+  const auto inserted_children =
+      std::get<ContainerState>(controller->model().nodes.at(root)).children;
+  ASSERT_EQ(4u, inserted_children.size());
+  EXPECT_EQ(background, std::get<LeafState>(
+                            controller->model().nodes.at(inserted_children[1]))
+                            .tab);
+
+  auto* tab = strip->GetTabAtIndex(3);
+  const tabs::TabHandle handle = tab->GetHandle();
+  const uint64_t generation = controller->generation();
+  auto replacement = NewContents(browser());
+  auto* replacement_ptr = replacement.get();
+  auto old_contents =
+      strip->DiscardWebContents(tab->GetContents(), std::move(replacement));
+  EXPECT_EQ(handle, tab->GetHandle());
+  EXPECT_EQ(background, controller->KeyForTab(tab));
+  ASSERT_EQ(tab, controller->ResolveTab(background));
+  EXPECT_EQ(replacement_ptr, controller->ResolveTab(background)->GetContents());
+  EXPECT_GT(controller->generation(), generation);
+  EXPECT_EQ(
+      inserted_children,
+      std::get<ContainerState>(controller->model().nodes.at(root)).children);
+
+  strip->ActivateTabAt(3);
+  EXPECT_EQ(background, ActiveKey(*controller));
+  strip->InsertWebContentsAt(4, NewContents(browser()), ADD_ACTIVE);
+  EXPECT_EQ(controller->KeyForTab(strip->GetActiveTab()),
+            ActiveKey(*controller));
+  EXPECT_TRUE(controller->model().Validate());
+}
