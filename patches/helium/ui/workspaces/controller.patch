+class WorkspaceControllerBrowserTest : public InProcessBrowserTest {
+ public:
+  WorkspaceControllerBrowserTest() {
+    features_.InitWithFeatures({kWorkspaceTabTracking, kWorkspaceContentsHost},
+                               {});
+  }
+
+ private:
+  base::test::ScopedFeatureList features_;
+};
