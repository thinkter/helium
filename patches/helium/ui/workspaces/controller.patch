+IN_PROC_BROWSER_TEST_F(WorkspaceControllerBrowserTest,
+                       ActivationRejectsReentrantAndObsoleteRequests) {
+  auto* strip = browser()->tab_strip_model();
+  strip->InsertWebContentsAt(1, NewContents(browser()), 0);
+  strip->InsertWebContentsAt(2, NewContents(browser()), 0);
+  auto* controller = WorkspaceController::From(browser());
+  ASSERT_EQ(Result::kStarted, controller->StartTracking());
+  auto* first = strip->GetTabAtIndex(0);
+  const TabKey second = controller->KeyForTab(strip->GetTabAtIndex(1));
+  const TabKey third = controller->KeyForTab(strip->GetTabAtIndex(2));
+  bool saw_deactivation = false;
+  auto subscription = first->RegisterWillDeactivate(
+      base::BindLambdaForTesting([&](tabs::TabInterface*) {
+        saw_deactivation = true;
+        // Queue, do not recursively enter TabStripModel's mutation guard.
+        EXPECT_TRUE(
+            controller->RequestActivateTab(third, controller->generation()));
+        // A modal/nested loop must not run the activation while the strip's
+        // mutation guard is held, even when ordinary nested tasks are allowed.
+        base::RunLoop nested(base::RunLoop::Type::kNestableTasksAllowed);
+        base::SingleThreadTaskRunner::GetCurrentDefault()->PostTask(
+            FROM_HERE, nested.QuitClosure());
+        nested.Run();
+        EXPECT_EQ(first, strip->GetActiveTab());
+      }));
+  ASSERT_TRUE(controller->RequestActivateTab(second, controller->generation()));
+  base::RunLoop().RunUntilIdle();
+  EXPECT_TRUE(saw_deactivation);
+  // The confirmed second-tab activation invalidated input issued while its
+  // pre-deactivation notification was still in flight.
+  EXPECT_EQ(second, ActiveKey(*controller));
+  EXPECT_EQ(strip->GetTabAtIndex(1), strip->GetActiveTab());
+  subscription = {};
+
+  ASSERT_TRUE(controller->RequestActivateTab(third, controller->generation()));
+  auto* target = strip->GetTabAtIndex(2);
+  auto old_contents =
+      strip->DiscardWebContents(target->GetContents(), NewContents(browser()));
+  base::RunLoop().RunUntilIdle();
+  EXPECT_EQ(second, ActiveKey(*controller));
+  EXPECT_EQ(third, controller->KeyForTab(target));
+
+  ASSERT_TRUE(controller->RequestActivateTab(third, controller->generation()));
+  auto detached = strip->DetachTabAtForInsertion(2);
+  base::RunLoop().RunUntilIdle();
+  EXPECT_EQ(second, ActiveKey(*controller));
+  EXPECT_FALSE(controller->ResolveTab(third));
+
+  const TabKey first_key = controller->KeyForTab(first);
+  ASSERT_TRUE(
+      controller->RequestActivateTab(first_key, controller->generation()));
+  controller->StopTracking();
+  ASSERT_EQ(Result::kStarted, controller->StartTracking());
+  base::RunLoop().RunUntilIdle();
+  EXPECT_EQ(strip->GetTabAtIndex(1), strip->GetActiveTab());
+  EXPECT_NE(second, ActiveKey(*controller));
+  EXPECT_TRUE(controller->model().Validate());
+}
