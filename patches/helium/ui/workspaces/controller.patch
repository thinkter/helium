+IN_PROC_BROWSER_TEST_F(WorkspaceControllerBrowserTest,
+                       PaneFocusRejectsStaleContentsAndLifetime) {
+  auto* strip = browser()->tab_strip_model();
+  strip->InsertWebContentsAt(1, NewContents(browser()), 0);
+  auto* view = BrowserView::GetBrowserViewForBrowser(browser());
+  view->GetWidget()->Activate();
+  base::RunLoop().RunUntilIdle();
+  ASSERT_TRUE(view->GetWidget()->IsActive());
+  auto* controller = WorkspaceController::From(browser());
+  ASSERT_EQ(Result::kStarted, controller->StartTracking());
+  const auto key = controller->KeyForTab(strip->GetTabAtIndex(1));
+  auto page = strip->GetWebContentsAt(1)->GetWeakPtr();
+  // Hidden tabbed leaves cannot use the renderer-focus entrypoint.
+  EXPECT_FALSE(
+      controller->RequestPaneFocus(key, page, controller->generation()));
+  auto& model = const_cast<WorkspaceLayoutModel&>(controller->model());
+  NodeId::Generator ids;
+  ASSERT_TRUE(model.SetLayout(LayoutKind::kHorizontal, ids));
+  controller->OnHostWindowChanged();
+  base::RunLoop().RunUntilIdle();
+  ASSERT_TRUE(
+      controller->RequestPaneFocus(key, page, controller->generation()));
+  EXPECT_EQ(0, strip->active_index());
+  // Replacement preserves handle/key but invalidates the captured contents.
+  auto old = strip->DiscardWebContents(page.get(), NewContents(browser()));
+  base::RunLoop().RunUntilIdle();
+  EXPECT_EQ(0, strip->active_index());
+  EXPECT_FALSE(
+      controller->RequestPaneFocus(key, page, controller->generation()));
+  auto replacement = strip->GetWebContentsAt(1)->GetWeakPtr();
+  const auto generation = controller->generation();
+  ASSERT_TRUE(controller->RequestPaneFocus(key, replacement, generation));
+  controller->OnHostWindowChanged();
+  base::RunLoop().RunUntilIdle();
+  EXPECT_EQ(0, strip->active_index());
+  EXPECT_FALSE(controller->RequestPaneFocus(key, replacement, generation));
+  ASSERT_TRUE(
+      controller->RequestPaneFocus(key, replacement, controller->generation()));
+  base::RunLoop().RunUntilIdle();
+  EXPECT_EQ(1, strip->active_index());
+  ASSERT_TRUE(controller->RequestPaneFocus(
+      controller->KeyForTab(strip->GetTabAtIndex(0)),
+      strip->GetWebContentsAt(0)->GetWeakPtr(), controller->generation()));
+  controller->StopTracking();
+  base::RunLoop().RunUntilIdle();
+  EXPECT_EQ(1, strip->active_index());
+  EXPECT_FALSE(controller->RequestPaneFocus(key, replacement, generation));
+}
