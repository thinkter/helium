+IN_PROC_BROWSER_TEST_F(WorkspaceControllerBrowserTest,
+                       DetachTransferAndIndependentIncognito) {
+  auto* source = WorkspaceController::From(browser());
+  ASSERT_EQ(Result::kStarted, source->StartTracking());
+  auto* strip = browser()->tab_strip_model();
+  strip->InsertWebContentsAt(1, NewContents(browser()), 0);
+  auto* tab = strip->GetTabAtIndex(1);
+  const auto handle = tab->GetHandle();
+  const TabKey source_key = source->KeyForTab(tab);
+  Browser* other = CreateBrowser(browser()->GetProfile());
+  auto* destination = WorkspaceController::From(other);
+  ASSERT_NE(source, destination);
+  ASSERT_EQ(Result::kStarted, destination->StartTracking());
+  bool saw_pre_detach = false;
+  auto detach_subscription = tab->RegisterWillDetach(base::BindLambdaForTesting(
+      [&](tabs::TabInterface*, tabs::TabInterface::DetachReason) {
+        saw_pre_detach = true;
+        EXPECT_FALSE(source->ResolveTab(source_key));
+        // Association/tree survive until the confirmed strip removal.
+        EXPECT_EQ(source_key, source->KeyForTab(tab));
+      }));
+  auto detached = strip->DetachTabAtForInsertion(1);
+  EXPECT_TRUE(saw_pre_detach);
+  detach_subscription = {};
+  EXPECT_FALSE(source->ResolveTab(source_key));
+  EXPECT_FALSE(source->KeyForTab(detached.get()));
+  other->tab_strip_model()->InsertDetachedTabAt(1, std::move(detached), 0);
+  EXPECT_EQ(handle.Get(), destination->ResolveTab(destination->KeyForTab(tab)));
+  EXPECT_FALSE(source->ResolveTab(source_key));
+  EXPECT_TRUE(source->model().Validate());
+  EXPECT_TRUE(destination->model().Validate());
+
+  Browser* incognito = CreateIncognitoBrowser();
+  auto* private_controller = WorkspaceController::From(incognito);
+  ASSERT_NE(source, private_controller);
+  ASSERT_EQ(Result::kStarted, private_controller->StartTracking());
+  EXPECT_FALSE(private_controller->KeyForTab(tab));
+  EXPECT_EQ(1u, private_controller->model().workspaces.size());
+  const TabKey old_key = ActiveKey(*source);
+  source->StopTracking();
+  EXPECT_EQ(0, TabStripModelObserver::CountObservedModels(source));
+  const uint64_t stopped_generation = source->generation();
+  strip->InsertWebContentsAt(1, NewContents(browser()), 0);
+  strip->DetachAndDeleteWebContentsAt(1);
+  EXPECT_EQ(stopped_generation, source->generation());
+  EXPECT_TRUE(source->model().nodes.empty());
+  EXPECT_FALSE(source->ResolveTab(old_key));
+  EXPECT_TRUE(destination->is_tracking());
+  EXPECT_TRUE(private_controller->is_tracking());
+  ASSERT_EQ(Result::kStarted, source->StartTracking());
+  EXPECT_NE(old_key, ActiveKey(*source));
+  EXPECT_EQ(1, TabStripModelObserver::CountObservedModels(source));
+  // Exercise BrowserWindowFeatures' actual teardown with a tracking controller.
+  CloseBrowserSynchronously(other);
+  EXPECT_FALSE(handle.Get());
+  EXPECT_TRUE(source->is_tracking());
+  EXPECT_TRUE(private_controller->is_tracking());
+}
