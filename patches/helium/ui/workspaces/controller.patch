+IN_PROC_BROWSER_TEST_F(WorkspaceControllerBrowserTest,
+                       UnsupportedWindowsAndNativeSplits) {
+  Browser* popup = CreateBrowserForPopup(browser()->GetProfile());
+  EXPECT_FALSE(WorkspaceController::From(popup));
+  {
+    // Constructor also guards manual/alternate ownership, not just the factory.
+    WorkspaceController unsupported(popup);
+    EXPECT_EQ(Result::kUnsupportedWindow, unsupported.StartTracking());
+  }
+  EXPECT_FALSE(WorkspaceController::From(popup));
+  auto* strip = browser()->tab_strip_model();
+  strip->InsertWebContentsAt(1, NewContents(browser()), 0);
+  auto split =
+      strip->AddToNewSplit({0, 1}, split_tabs::SplitTabVisualData(),
+                           split_tabs::SplitTabCreatedSource::kToolbarButton);
+  auto* controller = WorkspaceController::From(browser());
+  EXPECT_EQ(Result::kNativeSplitPresent, controller->StartTracking());
+  EXPECT_FALSE(controller->is_tracking());
+  strip->RemoveSplit(split);
+  ASSERT_EQ(Result::kStarted, controller->StartTracking());
+  strip->AddToNewSplit({0, 1}, split_tabs::SplitTabVisualData(),
+                       split_tabs::SplitTabCreatedSource::kToolbarButton);
+  EXPECT_FALSE(controller->is_tracking());
+  EXPECT_TRUE(controller->model().nodes.empty());
+  EXPECT_EQ(2, strip->count());
+}
