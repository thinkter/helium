+IN_PROC_BROWSER_TEST_F(WorkspaceContentsViewBrowserTest,
+                       CaptureSubscriptionsFollowRetainedHostReplacement) {
+  auto* browser_view = BrowserView::GetBrowserViewForBrowser(browser());
+  auto old_page = content::WebContents::Create(
+      content::WebContents::CreateParams(browser_view->GetProfile()));
+  auto replacement = content::WebContents::Create(
+      content::WebContents::CreateParams(browser_view->GetProfile()));
+  TabCaptureContentsBorderHelper::CreateForWebContents(old_page.get());
+  auto* capture =
+      TabCaptureContentsBorderHelper::FromWebContents(old_page.get());
+  capture->OnCapturerAdded(1);
+  const gfx::Rect original_region(5, 5, 100, 100);
+  capture->OnRegionCaptureRectChanged(1, original_region);
+
+  TabKey::Generator tab_ids;
+  WorkspaceId::Generator workspace_ids;
+  NodeId::Generator node_ids;
+  const TabKey key = tab_ids.GenerateNextId();
+  WorkspaceLayoutModel model;
+  model.CreateWorkspace(key, workspace_ids, node_ids);
+  auto* host = browser_view->AddChildView(
+      std::make_unique<WorkspaceContentsView>(browser_view));
+  base::ScopedClosureRunner remove_host(base::BindOnce(
+      [](BrowserView* parent, WorkspaceContentsView* child) {
+        parent->RemoveChildViewT(child);
+      },
+      browser_view, host));
+  host->SetBounds(0, 0, 800, 600);
+  ASSERT_TRUE(host->Present(model, {}, {{key, old_page.get()}}));
+  auto* container = host->GetContainerForTab(key);
+  ASSERT_NE(container, nullptr);
+  auto* border = container->capture_contents_border_view();
+  EXPECT_EQ(border->capture_location(), original_region);
+
+  ASSERT_TRUE(host->Present(model, {}, {{key, replacement.get()}}));
+  EXPECT_EQ(host->GetContainerForTab(key), container);
+  EXPECT_FALSE(border->GetVisible());
+  EXPECT_FALSE(border->capture_location().has_value());
+  // A detached page must not retain a location callback into a reused host.
+  capture->OnRegionCaptureRectChanged(1, gfx::Rect(10, 10, 200, 200));
+  EXPECT_FALSE(border->capture_location().has_value());
+  ASSERT_TRUE(host->Present(model, {}, {{key, old_page.get()}}));
+  EXPECT_EQ(border->capture_location(), gfx::Rect(10, 10, 200, 200));
+  host->Clear();
+  EXPECT_EQ(host->GetContainerForTab(key), nullptr);
+  EXPECT_TRUE(host->GetDisplayedContainers().empty());
+  capture->OnRegionCaptureRectChanged(1, original_region);
+  remove_host.RunAndReset();
+  capture->OnRegionCaptureRectChanged(1, gfx::Rect(20, 20, 100, 100));
+  EXPECT_FALSE(old_page->IsBeingDestroyed());
+  EXPECT_FALSE(replacement->IsBeingDestroyed());
+}
