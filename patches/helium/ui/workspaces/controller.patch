+IN_PROC_BROWSER_TEST_F(WorkspaceControllerBrowserTest,
+                       DeferredActivationRevealsConfirmedSelection) {
+  auto* strip = browser()->tab_strip_model();
+  strip->InsertWebContentsAt(1, NewContents(browser()), 0);
+  strip->InsertWebContentsAt(2, NewContents(browser()), 0);
+  auto* controller = WorkspaceController::From(browser());
+  ASSERT_EQ(Result::kStarted, controller->StartTracking());
+  const TabKey first = controller->KeyForTab(strip->GetTabAtIndex(0));
+  const TabKey second = controller->KeyForTab(strip->GetTabAtIndex(1));
+  const TabKey third = controller->KeyForTab(strip->GetTabAtIndex(2));
+  const uint64_t generation = controller->generation();
+  EXPECT_FALSE(controller->RequestActivateTab(TabKey(), generation));
+  EXPECT_FALSE(controller->RequestActivateTab(second, generation - 1));
+  ASSERT_TRUE(controller->RequestActivateTab(second, generation));
+  // Latest accepted request wins without exposing an intermediate selection.
+  ASSERT_TRUE(controller->RequestActivateTab(third, generation));
+  EXPECT_EQ(first, ActiveKey(*controller));
+  EXPECT_EQ(strip->GetTabAtIndex(0), strip->GetActiveTab());
+  base::RunLoop().RunUntilIdle();
+  EXPECT_EQ(strip->GetTabAtIndex(2), strip->GetActiveTab());
+  EXPECT_EQ(third, ActiveKey(*controller));
+  const auto& model = controller->model();
+  const auto& root =
+      std::get<ContainerState>(model.nodes.at(model.workspaces.front().root));
+  EXPECT_EQ(third,
+            std::get<LeafState>(model.nodes.at(root.selected_child)).tab);
+  EXPECT_TRUE(model.Validate());
+
+  // External activation supersedes queued input, rather than bouncing focus
+  // back to an obsolete surface on the next event-loop turn.
+  ASSERT_TRUE(controller->RequestActivateTab(second, controller->generation()));
+  strip->ActivateTabAt(0);
+  base::RunLoop().RunUntilIdle();
+  EXPECT_EQ(first, ActiveKey(*controller));
+  EXPECT_EQ(strip->GetTabAtIndex(0), strip->GetActiveTab());
+}
