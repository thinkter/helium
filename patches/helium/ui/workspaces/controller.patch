+helium::workspaces::WorkspaceContentsView*
+BrowserView::InstallWorkspaceContentsView() {
+  if (!workspace_contents_view_) {
+    // Publish the empty host before detachment so callback-driven teardown can
+    // reverse even a partially completed transfer. It has no attachments yet.
+    workspace_contents_view_ = AddChildView(
+        std::make_unique<helium::workspaces::WorkspaceContentsView>(this));
+    auto weak = weak_ptr_factory_.GetWeakPtr();
+    auto* host = workspace_contents_view_.get();
+    const auto containers = multi_contents_view_->contents_container_views();
+    for (const auto& container : containers) {
+      container->contents_view()->set_is_primary_web_contents_for_window(false);
+      container->contents_view()->SetWebContents(nullptr);
+      if (!weak || workspace_contents_view_ != host)
+        return nullptr;
+      container->SetVisible(false);
+      if (!weak || workspace_contents_view_ != host)
+        return nullptr;
+    }
+    workspace_contents_view_->SetVisible(true);
+    if (!weak || workspace_contents_view_ != host)
+      return nullptr;
+    InvalidateLayout();
+  }
+  return workspace_contents_view_.get();
+}
+
+void BrowserView::OnWorkspacePresentationCommitted() {
+  if (!workspace_contents_view_ || !workspace_active_change_pending_)
+    return;
+  auto* container = GetActiveContentsContainerView();
+  if (!container)
+    return;
+  auto* contents = container->contents_view()->web_contents();
+  workspace_active_change_pending_ = false;
+  auto weak = weak_ptr_factory_.GetWeakPtr();
+  auto page = contents->GetWeakPtr();
+  UpdateUIForContents(contents, true);
+  if (!weak || !page || !workspace_contents_view_) {
+    return;
+  }
+  container = GetActiveContentsContainerView();
+  if (!container || container->contents_view()->web_contents() != page.get()) {
+    return;
+  }
+  MaybeUpdateStoredFocusForWebContents(page.get());
+  // Native page/footer/overlay focus has already landed in the incoming pane.
+  // Likewise, retain keyboard/AX focus on a header or divider. External strip
+  // selection otherwise restores the destination's own stored focus, never a
+  // detached ordinary-host view.
+  auto* focused = GetFocusManager()->GetFocusedView();
+  bool keep_focus = container->Contains(focused);
+  for (auto* header : workspace_contents_view_->GetHeaders()) {
+    keep_focus |= header->Contains(focused);
+  }
+  for (auto* divider : workspace_contents_view_->GetDividers()) {
+    keep_focus |= divider->Contains(focused);
+  }
+  if (!browser_->tab_strip_model()->closing_all() && GetWidget()->IsVisible() &&
+      GetWidget()->IsActive() && !keep_focus) {
+    page->RestoreFocus();
+  } else if (!GetWidget()->IsActive()) {
+    GetFocusManager()->SetStoredFocusView(nullptr);
+    restore_focus_on_activation_ = true;
+  }
+  if (weak)
+    UpdateTitleBar();
+}
+
+void BrowserView::RemoveWorkspaceContentsView() {
+  workspace_active_change_pending_ = false;
+  if (!workspace_contents_view_)
+    return;
+  auto weak = weak_ptr_factory_.GetWeakPtr();
+  auto* host = workspace_contents_view_.get();
+  host->Clear();
+  if (!weak || workspace_contents_view_ != host)
+    return;
+  workspace_contents_view_ = nullptr;
+  RemoveChildViewT(host);
+  if (!weak)
+    return;
+  // Reverse the transfer only after the workspace has detached every page.
+  auto* active = browser_->tab_strip_model()->GetActiveWebContents();
+  multi_contents_view_->GetActiveContentsView()
+      ->set_is_primary_web_contents_for_window(true);
+  multi_contents_view_->GetActiveContentsView()->SetWebContents(active);
+  if (!weak)
+    return;
+  const auto containers = multi_contents_view_->contents_container_views();
+  for (const auto& container : containers) {
+    container->SetVisible(container->contents_view()->web_contents() != nullptr);
+    if (!weak)
+      return;
+  }
+  InvalidateLayout();
+}
