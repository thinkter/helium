+IN_PROC_BROWSER_TEST_F(WorkspaceControllerBrowserTest,
+                       ForegroundPreparationPrecedesNativeCommit) {
+  auto* strip = browser()->tab_strip_model();
+  strip->InsertWebContentsAt(1, NewContents(browser()), 0);
+  auto* controller = WorkspaceController::From(browser());
+  ASSERT_EQ(Result::kStarted, controller->StartTracking());
+  auto* first = strip->GetTabAtIndex(0);
+  auto* second = strip->GetTabAtIndex(1);
+  auto* host = BrowserView::GetBrowserViewForBrowser(browser())
+                   ->workspace_contents_view();
+  const auto first_key = controller->KeyForTab(first);
+  std::vector<std::string> events;
+  auto deactivate = first->RegisterWillDeactivate(
+      base::BindLambdaForTesting([&](tabs::TabInterface*) {
+        events.push_back("deactivate");
+        EXPECT_EQ(first, strip->GetActiveTab());
+        EXPECT_EQ(std::vector<tabs::TabInterface*>{first},
+                  strip->GetForegroundTabs());
+      }));
+  auto hide = first->RegisterWillBecomeHidden(
+      base::BindLambdaForTesting([&](tabs::TabInterface*) {
+        events.push_back("hide");
+        // Active identity has changed, but preparation has not detached the
+        // old page or optimistically published the incoming page.
+        EXPECT_EQ(second, strip->GetActiveTab());
+        EXPECT_TRUE(
+            host->HasCommittedAttachment(first_key, first->GetContents()));
+        EXPECT_EQ(std::vector<tabs::TabInterface*>{first},
+                  strip->GetForegroundTabs());
+        EXPECT_FALSE(strip->IsTabInForeground(1));
+      }));
+  auto activate = second->RegisterDidActivate(
+      base::BindLambdaForTesting([&](tabs::TabInterface*) {
+        events.push_back("activate");
+        EXPECT_EQ(std::vector<tabs::TabInterface*>{second},
+                  strip->GetForegroundTabs());
+        EXPECT_TRUE(host->HasCommittedAttachment(controller->KeyForTab(second),
+                                                 second->GetContents()));
+        EXPECT_FALSE(
+            host->HasCommittedAttachment(first_key, first->GetContents()));
+      }));
+  // Background insertion into a tabbed root does not hide or deactivate.
+  strip->InsertWebContentsAt(2, NewContents(browser()), 0);
+  EXPECT_TRUE(events.empty());
+  strip->ActivateTabAt(1);  // external selection uses the same preparation
+  EXPECT_EQ((std::vector<std::string>{"deactivate", "hide", "activate"}),
+            events);
+  strip->ActivateTabAt(0);
+  events.clear();
+  ASSERT_TRUE(controller->RequestActivateTab(controller->KeyForTab(second),
+                                             controller->generation()));
+  base::RunLoop().RunUntilIdle();
+  EXPECT_EQ((std::vector<std::string>{"deactivate", "hide", "activate"}),
+            events);
+}
