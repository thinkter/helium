+
+void TabStripModel::PrepareDisplayedTabsChange(
+    const std::vector<tabs::TabInterface*>& destination) {
+  std::vector<tabs::TabHandle> outgoing;
+  for (auto* tab : GetForegroundTabs()) {
+    if (!std::ranges::contains(destination, tab) &&
+        !std::ranges::contains(notifying_hidden_tabs_, tab->GetHandle())) {
+      outgoing.push_back(tab->GetHandle());
+    }
+  }
+  auto weak = weak_factory_.GetWeakPtr();
+  const auto epoch = displayed_tabs_epoch_;
+  const size_t already_notified = notifying_hidden_tabs_.size();
+  for (auto handle : outgoing) {
+    if (auto* tab = handle.Get()) {
+      notifying_hidden_tabs_.push_back(handle);
+      static_cast<tabs::TabModel*>(tab)->WillBecomeHidden(
+          base::PassKey<TabStripModel>());
+      if (!weak) {
+        return;
+      }
+      // Retain delivered notifications across the entire preparation callback
+      // stack. A nested disable must not re-notify an earlier outgoing leaf.
+      if (displayed_tabs_epoch_ != epoch) {
+        break;
+      }
+    }
+  }
+  notifying_hidden_tabs_.resize(already_notified);
+}
+
+void TabStripModel::PrepareDisplayedTabDetach(tabs::TabInterface* tab) {
+  if (!displayed_tab_detach_) {
+    return;
+  }
+  auto detach = displayed_tab_detach_;
+  auto weak = weak_factory_.GetWeakPtr();
+  auto handle = tab->GetHandle();
+  if (tab == GetActiveTab()) {
+    static_cast<tabs::TabModel*>(tab)->WillDeactivate(
+        base::PassKey<TabStripModel>());
+  }
+  if (weak && handle.Get() && displayed_tab_detach_) {
+    detach.Run(handle.Get());
+  }
+}
