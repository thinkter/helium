+IN_PROC_BROWSER_TEST_F(WorkspaceControllerBrowserTest,
+                       HeaderCommitsSubtreeSelectionWithActivation) {
+  auto* strip = browser()->tab_strip_model();
+  strip->InsertWebContentsAt(1, NewContents(browser()), 0);
+  strip->InsertWebContentsAt(2, NewContents(browser()), 0);
+  auto* view = BrowserView::GetBrowserViewForBrowser(browser());
+  view->GetWidget()->Activate();
+  base::RunLoop().RunUntilIdle();
+  ASSERT_TRUE(view->GetWidget()->IsActive());
+  auto* controller = WorkspaceController::From(browser());
+  ASSERT_EQ(Result::kStarted, controller->StartTracking());
+  auto& model = const_cast<WorkspaceLayoutModel&>(controller->model());
+  const auto root = model.workspaces.front().root;
+  auto& root_state = std::get<ContainerState>(model.nodes.at(root));
+  const auto children = root_state.children;
+  NodeId::Generator ids;
+  NodeId subtree;
+  do {
+    subtree = ids.GenerateNextId();
+  } while (model.nodes.contains(subtree));
+  model.nodes.emplace(subtree, ContainerState{LayoutKind::kHorizontal,
+                                              {children[1], children[2]},
+                                              children[1],
+                                              {1, 1},
+                                              children[1]});
+  root_state.children = {children[0], subtree};
+  root_state.split_weights = {1, 1};
+  ASSERT_TRUE(model.Validate());
+  controller->OnHostWindowChanged();
+  base::RunLoop().RunUntilIdle();
+  const auto generation = controller->generation();
+  ASSERT_TRUE(controller->RequestSelectChild(root, subtree, generation));
+  EXPECT_EQ(0, strip->active_index());
+  EXPECT_EQ(children[0], root_state.selected_child);
+  base::RunLoop().RunUntilIdle();
+  EXPECT_EQ(1, strip->active_index());
+  EXPECT_EQ(subtree, controller->model().workspaces.front().selected_node);
+  EXPECT_EQ(2u, strip->GetForegroundTabs().size());
+  EXPECT_FALSE(controller->RequestSelectChild(root, children[0], generation));
+  ASSERT_TRUE(controller->RequestSelectChild(root, children[0],
+                                             controller->generation()));
+  controller->StopTracking();
+  base::RunLoop().RunUntilIdle();
+  EXPECT_EQ(1, strip->active_index());
+}
