+void WorkspaceContentsView::Clear() {
+  ClearControls();
+  containers_.clear();
+  while (!leaves_.empty()) {
+    auto it = leaves_.begin();
+    auto* container = it->second.container.get();
     container->contents_view()->SetWebContents(nullptr);
+    leaves_.erase(it);
     RemoveChildViewT(container);
   }
 }
 
+ContentsContainerView* WorkspaceContentsView::GetContainerForTab(
