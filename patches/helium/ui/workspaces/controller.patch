+IN_PROC_BROWSER_TEST_F(WorkspaceControllerBrowserTest,
+                       ResizeUsesFrozenBaselineAndCancelsOldGestures) {
+  auto* strip = browser()->tab_strip_model();
+  strip->InsertWebContentsAt(1, NewContents(browser()), 0);
+  auto* view = BrowserView::GetBrowserViewForBrowser(browser());
+  view->GetWidget()->Activate();
+  base::RunLoop().RunUntilIdle();
+  ASSERT_TRUE(view->GetWidget()->IsActive());
+  auto* controller = WorkspaceController::From(browser());
+  ASSERT_EQ(Result::kStarted, controller->StartTracking());
+  auto& model = const_cast<WorkspaceLayoutModel&>(controller->model());
+  NodeId::Generator ids;
+  ASSERT_TRUE(model.SetLayout(LayoutKind::kHorizontal, ids));
+  controller->OnHostWindowChanged();
+  base::RunLoop().RunUntilIdle();
+  auto* host = view->workspace_contents_view();
+  ASSERT_EQ(1u, host->GetDividers().size());
+  auto* surface = host->GetDividers().front();
+  const auto target = surface->target();
+  const auto baseline = controller->model();
+  LayoutMetrics metrics;
+  metrics.rtl = base::i18n::IsRTL();
+  metrics.device_scale_factor =
+      host->GetWidget()->GetCompositor()->device_scale_factor();
+  const int width = std::round(host->width() * metrics.device_scale_factor);
+  const int height = std::round(host->height() * metrics.device_scale_factor);
+  const auto generation = controller->generation();
+  ASSERT_TRUE(controller->RequestResize({target, 10, true, false}, generation));
+  ASSERT_TRUE(controller->RequestResize({target, 20, true, false}, generation));
+  auto expected = baseline;
+  ASSERT_TRUE(ResizeWorkspace(expected, width, height, metrics, target, 20));
+  EXPECT_EQ(
+      std::get<ContainerState>(expected.nodes.at(target.container))
+          .split_weights,
+      std::get<ContainerState>(controller->model().nodes.at(target.container))
+          .split_weights);
+  EXPECT_EQ(surface, host->GetDividers().front());
+  ASSERT_TRUE(controller->RequestResize({target, 20, true, true}, generation));
+  ui::KeyEvent key(ui::EventType::kKeyPressed, ui::VKEY_RIGHT, ui::EF_NONE);
+  EXPECT_TRUE(surface->OnKeyPressed(key));
+  const int step = std::round(50 * metrics.device_scale_factor);
+  ASSERT_TRUE(ResizeWorkspace(expected, width, height, metrics, target,
+                              metrics.rtl ? -step : step));
+  EXPECT_EQ(
+      std::get<ContainerState>(expected.nodes.at(target.container))
+          .split_weights,
+      std::get<ContainerState>(controller->model().nodes.at(target.container))
+          .split_weights);
+  ui::AXActionData action;
+  action.action = ax::mojom::Action::kDecrement;
+  EXPECT_TRUE(surface->HandleAccessibleAction(action));
+  ASSERT_TRUE(ResizeWorkspace(expected, width, height, metrics, target, -step));
+  EXPECT_EQ(
+      std::get<ContainerState>(expected.nodes.at(target.container))
+          .split_weights,
+      std::get<ContainerState>(controller->model().nodes.at(target.container))
+          .split_weights);
+  // Exercise ResizeArea's private native drag state, not just its delegate.
+  ui::MouseEvent press(ui::EventType::kMousePressed, gfx::PointF(2, 5),
+                       gfx::PointF(2, 5), base::TimeTicks(),
+                       ui::EF_LEFT_MOUSE_BUTTON, ui::EF_LEFT_MOUSE_BUTTON);
+  ui::MouseEvent drag(ui::EventType::kMouseDragged, gfx::PointF(12, 5),
+                      gfx::PointF(12, 5), base::TimeTicks(),
+                      ui::EF_LEFT_MOUSE_BUTTON, ui::EF_LEFT_MOUSE_BUTTON);
+  ASSERT_TRUE(surface->OnMousePressed(press));
+  ASSERT_TRUE(surface->OnMouseDragged(drag));
+  EXPECT_TRUE(surface->is_resizing());
+  EXPECT_EQ(surface, host->GetDividers().front());
+  const auto captured =
+      std::get<ContainerState>(controller->model().nodes.at(target.container))
+          .split_weights;
+  surface->OnMouseCaptureLost();
+  EXPECT_FALSE(surface->is_resizing());
+  EXPECT_EQ(captured, std::get<ContainerState>(
+                          controller->model().nodes.at(target.container))
+                          .split_weights);
+  ASSERT_TRUE(surface->OnMousePressed(press));
+  ASSERT_TRUE(surface->OnMouseDragged(drag));
+  controller->OnHostWindowChanged();
+  base::RunLoop().RunUntilIdle();
+  const auto canceled =
+      std::get<ContainerState>(controller->model().nodes.at(target.container))
+          .split_weights;
+  EXPECT_FALSE(surface->is_resizing());
+  EXPECT_FALSE(surface->OnMouseDragged(drag));
+  surface->OnResize(500, false);
+  EXPECT_FALSE(
+      controller->RequestResize({target, 500, true, false}, generation));
+  EXPECT_EQ(canceled, std::get<ContainerState>(
+                          controller->model().nodes.at(target.container))
+                          .split_weights);
+  strip->InsertWebContentsAt(2, NewContents(browser()), 0);
+  EXPECT_FALSE(
+      controller->RequestResize({target, 500, true, true}, generation));
+  EXPECT_TRUE(controller->model().Validate());
+  EXPECT_TRUE(controller->is_tracking());
+  EXPECT_EQ(0, strip->active_index());
+}
