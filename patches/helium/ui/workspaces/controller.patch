+TabKey ActiveKey(const WorkspaceController& controller) {
+  const auto& model = controller.model();
+  for (const auto& workspace : model.workspaces) {
+    if (workspace.id == model.active_workspace && workspace.active_leaf) {
+      return std::get<LeafState>(model.nodes.at(workspace.active_leaf)).tab;
+    }
+  }
+  return TabKey();
+}
+
+std::unique_ptr<content::WebContents> NewContents(Browser* browser) {
+  return content::WebContents::Create(
+      content::WebContents::CreateParams(browser->GetProfile()));
+}
