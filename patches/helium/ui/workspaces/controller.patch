+class WorkspaceContentsView;
+struct WorkspaceResizeRequest;
+
+BASE_DECLARE_FEATURE(kWorkspaceTabTracking);
+
+// Per-window, memory-only policy and activation adapter. Tabs and WebContents
+// remain Chromium-owned; BrowserView owns the native presentation. There is no
+// public enablement path. BrowserWindowFeatures destroys this before the window
+// and tab strip.
+class WorkspaceController : public TabStripModelObserver {
+ public:
+  DECLARE_USER_DATA(WorkspaceController);
+  enum class StartResult {
+    kStarted,
+    kFeatureDisabled,
+    kUnsupportedWindow,
+    kNativeSplitPresent
+  };
+
+  explicit WorkspaceController(BrowserWindowInterface* window);
+  ~WorkspaceController() override;
+  WorkspaceController(const WorkspaceController&) = delete;
+  WorkspaceController& operator=(const WorkspaceController&) = delete;
+
+  static WorkspaceController* From(BrowserWindowInterface* window);
+  // Explicit internal host opt-in; not called by production UI. Native
+  // splits must be closed first. Later split creation stops tracking rather
+  // than migrating/destroying tabs. T11 must enforce exclusion before exposure.
+  StartResult StartTracking();
+  void StopTracking();
+  bool is_tracking() const { return tracking_; }
+  const WorkspaceLayoutModel& model() const { return model_; }
+
+  // UI-thread, borrowed result for immediate use only. Resolves the handle and
+  // verifies current window membership every time; never cache its contents.
+  tabs::TabInterface* ResolveTab(TabKey key) const;
+  TabKey KeyForTab(const tabs::TabInterface* tab) const;
+
+  // Requests actual Chromium activation, not just tree selection. Dispatch is
+  // deferred out of tab-strip observer/focus stacks; true means queued, not
+  // activated. Only the latest accepted request survives, and any intervening
+  // lifecycle/selection change invalidates it. Confirmed strip selection drives
+  // RevealTab, so toolbar/commands and the tree share the same authority.
+  // Internal hidden-tab reveal API; native pane focus must instead use the
+  // displayed-membership-validated RequestPaneFocus entrypoint below.
+  bool RequestActivateTab(TabKey key, uint64_t expected_generation);
+  // Native page/accessory focus, not a generic hidden-tab reveal request.
+  bool RequestPaneFocus(TabKey key,
+                        base::WeakPtr<content::WebContents> contents,
+                        uint64_t expected_generation);
+  bool RequestSelectChild(NodeId container,
+                          NodeId child,
+                          uint64_t expected_generation);
+  bool RequestResize(WorkspaceResizeRequest request,
+                     uint64_t expected_generation);
+
+  // Commits the host's actual displayed leaves. This is deliberately separate
+  // from model visibility: foreground/discard policy follows successful native
+  // attachment, not a projected tree. Publication follows native commit.
+  void SetDisplayedTabs(std::vector<TabKey> keys);
+  bool PresentHost();
+  // Called by BrowserView after its layout/scale pass. The host bounds are
+  // owned by BrowserView; presentation is revalidated before publication.
+  void OnHostLayoutChanged();
+  // Window visibility/activation/screen-position changes revoke native input.
+  void OnHostWindowChanged();
+
+  // Invalidates presentation/gesture requests on every observed change,
+  // including pre-detach/discard.
+  // Input binds weak lifetime + generation. Weight-only gesture commits retain
+  // the generation and frozen baseline; external changes revoke both.
+  uint64_t generation() const { return generation_; }
+
+ private:
+  void ActivateRequestedTab(TabKey key, uint64_t expected_generation);
+  void ActivateInputTab(tabs::TabInterface* tab);
+  void SelectRequestedChild(NodeId container,
+                            NodeId child,
+                            uint64_t expected_generation);
+  void CancelInput();
+  LayoutMetrics CurrentMetrics() const;
+  bool CanAcceptInput(uint64_t expected_generation) const;
+  std::vector<tabs::TabInterface*> GetDisplayedTabs() const;
+  bool HasNativeSplit() const;
+  TabKey Associate(tabs::TabInterface* tab);
+  void WillDetach(tabs::TabInterface* tab,
+                  tabs::TabInterface::DetachReason reason);
+  void WillDiscard(tabs::TabInterface* tab,
+                   content::WebContents* old_contents,
+                   content::WebContents* new_contents);
+  void ReconcileTabStripChange(const TabStripModelChange& change,
+                               const TabStripSelectionChange& selection);
+  void PrepareDisplayedTabs(const std::vector<TabKey>& keys);
+  void DetachConfirmedTab(tabs::TabInterface* tab);
+  void OnTabStripModelDestroyed(TabStripModel* tab_strip_model) override;
+  void OnSplitTabChanged(const SplitTabChange& change) override;
+
+  const raw_ptr<BrowserWindowInterface> window_;
+  WorkspaceLayoutModel model_;
+  TabKey::Generator tab_ids_;
+  NodeId::Generator node_ids_;
+  WorkspaceId::Generator workspace_ids_;
+  std::map<TabKey, tabs::TabHandle> tabs_;
+  std::map<TabKey, std::vector<base::CallbackListSubscription>> subscriptions_;
+  // WillDetach is deliberately staged: Chromium may cancel a close or move.
+  // Keep the committed host projection until the model confirms removal.
+  std::set<TabKey> detaching_;
+  std::vector<TabKey> displayed_keys_;
+  raw_ptr<BrowserView> browser_view_ = nullptr;
+  raw_ptr<WorkspaceContentsView> workspace_host_ = nullptr;
+  struct ResizeGesture {
+    WorkspaceLayoutModel baseline;
+    ResizeTarget target;
+    gfx::Rect bounds;
+    LayoutMetrics metrics;
+  };
+  std::optional<ResizeGesture> resize_gesture_;
+  std::optional<WorkspaceLayoutModel> header_destination_;
+  gfx::Rect presented_bounds_;
+  LayoutMetrics presented_metrics_;
+  uint64_t generation_ = 0;
+  bool tracking_ = false;
+  bool changing_tracking_ = false;
+  bool stopping_tracking_ = false;
+  bool presenting_host_ = false;
+  bool activating_input_ = false;
+
+  ui::ScopedUnownedUserData<WorkspaceController> scoped_unowned_user_data_;
+  base::WeakPtrFactory<WorkspaceController> activation_requests_{this};
+  // Separate from input cancellation: a new focus request must not invalidate
+  // the provider or an in-progress presentation's lifetime guard.
+  base::WeakPtrFactory<WorkspaceController> lifetime_{this};
+};
+
+}  // namespace helium::workspaces
