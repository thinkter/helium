+// This is the explicit input boundary: a standalone header with NO page hosts.
+// Do not enable input on WorkspaceContentsView to exercise header callbacks.
+IN_PROC_BROWSER_TEST_F(WorkspaceContentsViewBrowserTest,
+                       ImmediateSubtreeSelectorsAndNativeActions) {
+  WorkspaceLayoutModel model;
+  WorkspaceId::Generator workspace_ids;
+  NodeId::Generator node_ids;
+  TabKey::Generator tab_ids;
+  const TabKey email = tab_ids.GenerateNextId();
+  const TabKey a = tab_ids.GenerateNextId();
+  const TabKey b = tab_ids.GenerateNextId();
+  model.CreateWorkspace(email, workspace_ids, node_ids);
+  const NodeId email_leaf = model.workspaces.front().active_leaf;
+  ASSERT_TRUE(
+      model.SplitLeaf(email_leaf, LayoutKind::kHorizontal, a, node_ids));
+  const NodeId a_leaf = model.workspaces.front().active_leaf;
+  ASSERT_TRUE(model.SplitLeaf(a_leaf, LayoutKind::kVertical, b, node_ids));
+  const NodeId root = model.workspaces.front().root;
+  ASSERT_TRUE(model.SelectNode(root));
+  ASSERT_TRUE(model.SetLayout(LayoutKind::kTabbed, node_ids));
+  const auto children = std::get<ContainerState>(model.nodes.at(root)).children;
+  ASSERT_EQ(children.size(), 2u);
+  ASSERT_TRUE(model.SetSelectedChild(root, email_leaf));
+
+  NodeId requested_container;
+  NodeId requested_child;
+  int requests = 0;
+  auto surface = std::make_unique<WorkspaceTabbedHeaderView>(
+      base::BindLambdaForTesting([&](NodeId container, NodeId child) {
+        requested_container = container;
+        requested_child = child;
+        ++requests;
+      }));
+  auto* browser_view = BrowserView::GetBrowserViewForBrowser(browser());
+  auto* header = browser_view->AddChildView(std::move(surface));
+  base::ScopedClosureRunner remove_header(base::BindOnce(
+      [](BrowserView* parent, WorkspaceTabbedHeaderView* child) {
+        parent->RemoveChildViewT(child);
+      },
+      browser_view, header));
+  header->SetBounds(0, 0, 600, 30);
+  ASSERT_TRUE(header->Update(model, root, {{email, u"Email"}, {b, u"B"}}));
+  views::test::RunScheduledLayout(header);
+  EXPECT_EQ(header->child_ids(), children);
+  ASSERT_EQ(header->children().size(), 2u);
+  auto* split_button = static_cast<views::LabelButton*>(header->children()[1]);
+  EXPECT_NE(split_button->GetText().find(u"Layout:"), std::u16string::npos);
+  ui::AXNodeData data;
+  split_button->GetViewAccessibility().GetAccessibleNodeData(&data);
+  EXPECT_EQ(data.role, ax::mojom::Role::kTab);
+  EXPECT_FALSE(data.GetBoolAttribute(ax::mojom::BoolAttribute::kSelected));
+
+  // Native pointer dispatch and AX default action share the same ID contract.
+  ui::MouseEvent press(ui::EventType::kMousePressed, gfx::PointF(5, 5),
+                       gfx::PointF(5, 5), base::TimeTicks(),
+                       ui::EF_LEFT_MOUSE_BUTTON, ui::EF_LEFT_MOUSE_BUTTON);
+  EXPECT_TRUE(split_button->OnMousePressed(press));
+  ui::MouseEvent release(ui::EventType::kMouseReleased, gfx::PointF(5, 5),
+                         gfx::PointF(5, 5), base::TimeTicks(),
+                         ui::EF_LEFT_MOUSE_BUTTON, ui::EF_LEFT_MOUSE_BUTTON);
+  split_button->OnMouseReleased(release);
+  EXPECT_EQ(requests, 1);
+  EXPECT_EQ(requested_container, root);
+  EXPECT_EQ(requested_child, children[1]);
+  ui::AXActionData action;
+  action.action = ax::mojom::Action::kDoDefault;
+  EXPECT_TRUE(split_button->HandleAccessibleAction(action));
+  EXPECT_EQ(requests, 2);
+  // Dispatch is a request only; until the owner commits, selection stays put.
+  EXPECT_EQ(header->selected_child(), email_leaf);
+  EXPECT_EQ(model.workspaces.front().active_leaf, email_leaf);
+  ASSERT_TRUE(model.SetSelectedChild(requested_container, requested_child));
+  ASSERT_TRUE(header->Update(model, root, {}));
+  EXPECT_EQ(header->selected_child(), children[1]);
+  split_button = static_cast<views::LabelButton*>(header->children()[1]);
+  data = ui::AXNodeData();
+  split_button->GetViewAccessibility().GetAccessibleNodeData(&data);
+  EXPECT_TRUE(data.GetBoolAttribute(ax::mojom::BoolAttribute::kSelected));
+  EXPECT_NE(split_button->GetText().find(u"Untitled page"),
+            std::u16string::npos);
+  header->UpdateTitles({{b, u"New\n\u202etitle"}});
+  EXPECT_NE(split_button->GetText().find(u"Newtitle"), std::u16string::npos);
+  EXPECT_FALSE(header->Update(model, NodeId(), {}));
+  EXPECT_FALSE(header->Update(model, email_leaf, {}));
+  EXPECT_EQ(header->child_ids(), children);
+  header->UpdateTitles({{b, std::u16string(1000, u'x')}});
+  EXPECT_LT(split_button->GetText().size(), 180u);
+  // A valid tabbed node hidden behind its ancestor is not a visible selector.
+  ASSERT_TRUE(model.SelectNode(children[1]));
+  ASSERT_TRUE(model.SetLayout(LayoutKind::kTabbed, node_ids));
+  ASSERT_TRUE(model.SetSelectedChild(root, email_leaf));
+  EXPECT_FALSE(header->Update(model, children[1], {}));
+  EXPECT_EQ(header->container(), root);
+}
