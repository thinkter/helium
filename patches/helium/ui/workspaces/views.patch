+
+class WorkspaceContentsViewBrowserTest : public InProcessBrowserTest {
+ public:
+  WorkspaceContentsViewBrowserTest() {
+    features_.InitAndEnableFeature(kWorkspaceContentsHost);
+  }
+
+ private:
+  base::test::ScopedFeatureList features_;
+};
+
+IN_PROC_BROWSER_TEST_F(WorkspaceContentsViewBrowserTest,
+                       LiveLeavesAndSelectedSplitSubtree) {
+  auto* browser_view = BrowserView::GetBrowserViewForBrowser(browser());
+  auto* ordinary = browser_view->multi_contents_view()->GetActiveContentsView();
+  auto* ordinary_contents = ordinary->web_contents();
+  std::vector<std::unique_ptr<content::WebContents>> pages;
+  std::map<TabKey, content::WebContents*> bindings;
+  TabKey::Generator tab_ids;
+  std::vector<TabKey> tabs;
+  for (int i = 0; i < 4; ++i) {
+    tabs.push_back(tab_ids.GenerateNextId());
+    pages.push_back(content::WebContents::Create(
+        content::WebContents::CreateParams(browser_view->GetProfile())));
+    ASSERT_TRUE(content::NavigateToURL(pages.back().get(),
+                                       GURL("data:text/html,workspace")));
+    bindings.emplace(tabs.back(), pages.back().get());
+  }
+
+  WorkspaceLayoutModel model;
+  WorkspaceId::Generator workspace_ids;
+  NodeId::Generator node_ids;
+  model.CreateWorkspace(tabs[0], workspace_ids, node_ids);
+  const NodeId first = model.workspaces.front().active_leaf;
+  ASSERT_TRUE(
+      model.SplitLeaf(first, LayoutKind::kHorizontal, tabs[1], node_ids));
+  const NodeId second = model.workspaces.front().active_leaf;
+  ASSERT_TRUE(
+      model.SplitLeaf(second, LayoutKind::kVertical, tabs[2], node_ids));
+  ASSERT_TRUE(model.InsertTab(tabs[3], tabs[0], OpenDisposition::kBackground,
+                              node_ids));
+
+  // Ownership remains outside the host. Remove it before destroying pages.
+  auto owned_host = std::make_unique<WorkspaceContentsView>(browser_view);
+  auto* host = browser_view->AddChildView(std::move(owned_host));
+  base::ScopedClosureRunner remove_host(base::BindOnce(
+      [](BrowserView* parent, WorkspaceContentsView* child) {
+        parent->RemoveChildViewT(child);
+      },
+      browser_view, host));
+  host->SetBounds(0, 0, 801, 601);
+  LayoutMetrics metrics;
+  metrics.device_scale_factor = 1.25;
+  metrics.rtl = true;
+  EXPECT_TRUE(host->Present(model, metrics, bindings));
+  views::test::RunScheduledLayout(host);
+  auto containers = host->GetDisplayedContainers();
+  ASSERT_EQ(containers.size(), 4u);
+  EXPECT_FALSE(host->GetMirrored());
+  EXPECT_EQ(containers[0]->bounds(), gfx::Rect(536, 0, 265, 601));
+  EXPECT_EQ(containers[1]->bounds(), gfx::Rect(268, 0, 264, 601));
+  EXPECT_EQ(containers[2]->bounds(), gfx::Rect(0, 0, 264, 298));
+  EXPECT_EQ(containers[3]->bounds(), gfx::Rect(0, 302, 264, 299));
+  for (auto* container : containers) {
+    EXPECT_TRUE(container->IsDrawn());
+    EXPECT_GT(container->contents_view()->width(), 0);
+    EXPECT_NE(container->contents_view()->web_contents(), nullptr);
+    EXPECT_EQ(container->GetMirroredBounds(), container->bounds());
+  }
+  const auto geometry = CalculateWorkspaceGeometry(model, 1001, 751, metrics);
+  EXPECT_GT(containers.front()->x(), containers.back()->x());
+  for (size_t i = 0; i < containers.size(); ++i) {
+    const auto tab =
+        std::get<LeafState>(model.nodes.at(geometry.leaves[i].node)).tab;
+    EXPECT_EQ(containers[i]->contents_view()->web_contents(), bindings.at(tab));
+  }
+
+  // A missing binding must not partially detach the current native tree.
+  auto incomplete = bindings;
+  incomplete.erase(tabs[0]);
+  EXPECT_FALSE(host->Present(model, metrics, incomplete));
+  EXPECT_EQ(host->GetDisplayedContainers(), containers);
+
+  const NodeId root = model.workspaces.front().root;
+  ASSERT_TRUE(model.SelectNode(root));
+  ASSERT_TRUE(model.SetLayout(LayoutKind::kTabbed, node_ids));
+  const auto& children =
+      std::get<ContainerState>(model.nodes.at(root)).children;
+  const NodeId split = children.back();
+  ASSERT_TRUE(model.SetSelectedChild(root, split));
+  EXPECT_TRUE(host->Present(model, metrics, bindings));
+  containers = host->GetDisplayedContainers();
+  ASSERT_EQ(containers.size(), 2u);
+  EXPECT_EQ(containers[0]->contents_view()->web_contents(), pages[1].get());
+  EXPECT_EQ(containers[1]->contents_view()->web_contents(), pages[2].get());
+  ASSERT_TRUE(model.SetSelectedChild(root, first));
+  EXPECT_TRUE(host->Present(model, metrics, bindings));
+  ASSERT_EQ(host->GetDisplayedContainers().size(), 1u);
+  EXPECT_EQ(host->GetDisplayedContainers()[0]->contents_view()->web_contents(),
+            pages[0].get());
+  host->SetSize(gfx::Size());
+  EXPECT_TRUE(host->Present(model, metrics, bindings));
+  EXPECT_TRUE(host->GetDisplayedContainers().empty());
+  EXPECT_EQ(ordinary->web_contents(), ordinary_contents);
+  remove_host.RunAndReset();
+  for (const auto& page : pages) {
+    EXPECT_FALSE(page->IsBeingDestroyed());
+  }
+}
