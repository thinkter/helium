+#ifndef CHROME_BROWSER_UI_VIEWS_FRAME_WORKSPACE_TABBED_HEADER_VIEW_H_
+#define CHROME_BROWSER_UI_VIEWS_FRAME_WORKSPACE_TABBED_HEADER_VIEW_H_
+
+#include <map>
+#include <string>
+#include <vector>
+
+#include "base/functional/callback.h"
+#include "base/memory/raw_ptr.h"
+#include "base/memory/weak_ptr.h"
+#include "chrome/browser/ui/helium/workspaces/workspace_layout_model.h"
+#include "ui/views/view.h"
+
+namespace views {
+class LabelButton;
+}
+
+namespace helium::workspaces {
+
+// Native, contents-free selector surface. One button per IMMEDIATE child, not
+// per leaf. A callback requests a mutation; it never changes model/activation.
+// The receiver must revalidate IDs against its current generation/workspace,
+// reconcile browser activation, then present the resulting snapshot. A null
+// callback makes the surface display-only (the incomplete host uses this).
+class WorkspaceTabbedHeaderView : public views::View {
+  METADATA_HEADER(WorkspaceTabbedHeaderView, views::View)
+
+ public:
+  using Titles = std::map<TabKey, std::u16string>;
+  using SelectChild = base::RepeatingCallback<void(NodeId, NodeId)>;
+
+  explicit WorkspaceTabbedHeaderView(SelectChild select_child);
+  ~WorkspaceTabbedHeaderView() override;
+
+  // Reject invalid/non-tabbed/hidden containers without changing the surface.
+  // Snapshots contain only stable IDs and copied labels; no model/page
+  // pointers.
+  bool Update(const WorkspaceLayoutModel& model,
+              NodeId container,
+              const Titles& titles);
+  // Caller supplies current titles, including hidden children. Missing titles
+  // have a safe fallback; no WebContents observer or owner lives here.
+  void UpdateTitles(const Titles& titles);
+  NodeId container() const { return container_; }
+  NodeId selected_child() const { return selected_child_; }
+  const std::vector<NodeId>& child_ids() const { return child_ids_; }
+
+ private:
+  void RequestSelection(NodeId child);
+
+  SelectChild select_child_;
+  NodeId container_;
+  NodeId selected_child_;
+  std::vector<NodeId> child_ids_;
+  std::vector<TabKey> title_keys_;
+  std::vector<bool> subtrees_;
+  std::vector<raw_ptr<views::LabelButton>> buttons_;
+  base::WeakPtrFactory<WorkspaceTabbedHeaderView> weak_factory_{this};
+};
+
+}  // namespace helium::workspaces
+#endif  // CHROME_BROWSER_UI_VIEWS_FRAME_WORKSPACE_TABBED_HEADER_VIEW_H_
