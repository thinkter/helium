+#ifndef CHROME_BROWSER_UI_VIEWS_FRAME_WORKSPACE_CONTENTS_VIEW_H_
+#define CHROME_BROWSER_UI_VIEWS_FRAME_WORKSPACE_CONTENTS_VIEW_H_
+
+#include <map>
+#include <vector>
+
+#include "base/feature_list.h"
+#include "base/memory/raw_ptr.h"
+#include "chrome/browser/ui/helium/workspaces/workspace_layout_geometry.h"
+#include "ui/views/view.h"
+
+class BrowserView;
+class ContentsContainerView;
+namespace content {
+class WebContents;
+}
+
+namespace helium::workspaces {
+
+BASE_DECLARE_FEATURE(kWorkspaceContentsHost);
+
+// Experimental rendering harness, NOT a BrowserView content-host replacement.
+// No browser construction path uses this class, even when the feature is on.
+// BrowserView must outlive it. Callers must supply externally owned contents
+// not attached to another WebView and Clear() before transferring them
+// elsewhere. Input is resolved afresh per presentation; the model never owns
+// WebContents. Views event handling is disabled, but this is NOT a native-input
+// or focus isolation boundary. Controlled tests only: activation, foreground and
+// modal-host adapters must exist before browser use. No primary-window AX
+// designation is made here.
+class WorkspaceContentsView : public views::View {
+  METADATA_HEADER(WorkspaceContentsView, views::View)
+
+ public:
+  explicit WorkspaceContentsView(BrowserView* browser_view);
+  ~WorkspaceContentsView() override;
+
+  // Uses this view's current DIP size. Call again after resize/scale changes.
+  // Validates the entire displayed binding set before changing native views.
+  // Header/divider rectangles are reserved but not rendered in this checkpoint.
+  bool Present(const WorkspaceLayoutModel& model,
+               const LayoutMetrics& metrics,
+               const std::map<TabKey, content::WebContents*>& contents);
+  void Clear();
+
+  // Tree order, only currently attached leaves. Pointers expire on
+  // Present/Clear.
+  std::vector<ContentsContainerView*> GetDisplayedContainers() const;
+
+ private:
+  raw_ptr<BrowserView> browser_view_;
+  std::vector<raw_ptr<ContentsContainerView>> containers_;
+  bool presenting_ = false;
+};
+
+}  // namespace helium::workspaces
+#endif  // CHROME_BROWSER_UI_VIEWS_FRAME_WORKSPACE_CONTENTS_VIEW_H_
