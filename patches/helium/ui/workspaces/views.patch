+WorkspaceContentsView::WorkspaceContentsView(BrowserView* browser_view)
+    : browser_view_(browser_view) {
+  CHECK(browser_view_);
+  CHECK(base::FeatureList::IsEnabled(kWorkspaceContentsHost));
+  // Geometry already mirrors physical horizontal coordinates in RTL. Disable
+  // parent mirroring only; native leaf contents retain their own text
+  // direction.
+  SetMirrored(false);
+  SetCanProcessEventsWithinSubtree(false);
+}
+
+WorkspaceContentsView::~WorkspaceContentsView() {
+  Clear();
+}
+
+bool WorkspaceContentsView::Present(
+    const WorkspaceLayoutModel& model,
+    const LayoutMetrics& metrics,
+    const std::map<TabKey, content::WebContents*>& contents,
+    const WorkspaceTabbedHeaderView::Titles& titles) {
+  if (presenting_) {
+    return false;
+  }
+  base::AutoReset<bool> presenting(&presenting_, true);
+  const double scale = metrics.device_scale_factor;
+  const double pixel_width = std::round(width() * scale);
+  const double pixel_height = std::round(height() * scale);
+  if (!std::isfinite(scale) || scale <= 0 || !std::isfinite(pixel_width) ||
+      !std::isfinite(pixel_height) ||
+      pixel_width > std::numeric_limits<int>::max() ||
+      pixel_height > std::numeric_limits<int>::max()) {
+    return false;
+  }
+  const auto geometry =
+      CalculateWorkspaceGeometry(model, static_cast<int>(pixel_width),
+                                 static_cast<int>(pixel_height), metrics);
+  if (!geometry.valid) {
+    return false;
+  }
+
+  // Use the same shared-edge conversion for pages, headers and selection.
+  auto dip_rect = [&](const LayoutRect& r) {
+    auto edge = [scale](int value, int pixels, int dips) {
+      return value == pixels
+                 ? dips
+                 : std::clamp(static_cast<int>(std::round(value / scale)), 0,
+                              dips);
+    };
+    const int x = edge(r.x, pixel_width, width());
+    const int y = edge(r.y, pixel_height, height());
+    return gfx::Rect(x, y, edge(r.x + r.width, pixel_width, width()) - x,
+                     edge(r.y + r.height, pixel_height, height()) - y);
+  };
+  std::vector<content::WebContents*> resolved;
+  std::vector<gfx::Rect> bounds;
+  std::set<content::WebContents*> unique;
+  for (const auto& leaf : geometry.leaves) {
+    auto it = contents.find(std::get<LeafState>(model.nodes.at(leaf.node)).tab);
+    if (it == contents.end() || !it->second ||
+        it->second->GetBrowserContext() != browser_view_->GetProfile() ||
+        !unique.insert(it->second).second) {
+      return false;
+    }
+    const auto rect = dip_rect(leaf.bounds);
+    if (rect.IsEmpty()) {
+      // Do not claim a displayed leaf that Views cannot represent in DIPs.
+      return false;
+    }
+    bounds.push_back(rect);
+    resolved.push_back(it->second);
+  }
+
+  std::vector<std::unique_ptr<WorkspaceTabbedHeaderView>> headers;
+  for (const auto& header : geometry.headers) {
+    auto view = std::make_unique<WorkspaceTabbedHeaderView>(
+        WorkspaceTabbedHeaderView::SelectChild());
+    if (!view->Update(model, header.container, titles)) {
+      return false;
+    }
+    view->SetBoundsRect(dip_rect(header.bounds));
+    headers.push_back(std::move(view));
+  }
+
+  // Structural selection outlines its visible subtree, never the active page
+  // by proxy. Hidden selections have no rectangle. Suppress container outlines
+  // in constrained mode rather than suggesting the full subtree is displayed.
+  std::set<NodeId> selected_subtree;
+  for (const auto& workspace : model.workspaces) {
+    if (workspace.id != model.active_workspace || !workspace.selected_node) {
+      continue;
+    }
+    if (geometry.constrained &&
+        workspace.selected_node != workspace.active_leaf) {
+      break;
+    }
+    std::vector<NodeId> pending{workspace.selected_node};
+    while (!pending.empty()) {
+      const NodeId id = pending.back();
+      pending.pop_back();
+      selected_subtree.insert(id);
+      if (const auto* node = std::get_if<ContainerState>(&model.nodes.at(id))) {
+        pending.insert(pending.end(), node->children.begin(),
+                       node->children.end());
+      }
+    }
+    break;
+  }
+  gfx::Rect selection;
+  for (const auto& leaf : geometry.leaves) {
+    if (selected_subtree.contains(leaf.node)) {
+      selection.Union(dip_rect(leaf.bounds));
+    }
+  }
+  for (const auto& header : geometry.headers) {
+    if (selected_subtree.contains(header.container)) {
+      selection.Union(dip_rect(header.bounds));
+    }
+  }
+
+  // Detach all old contents before attaching any new ones: a selected subtree
+  // can reorder/reuse the same externally owned pages in different slots.
+  Clear();
+  for (size_t i = 0; i < resolved.size(); ++i) {
+    auto* container =
+        AddChildView(std::make_unique<ContentsContainerView>(browser_view_));
+    containers_.push_back(container);
+    container->SetBoundsRect(bounds[i]);
+    container->contents_view()->SetWebContents(resolved[i]);
+    if (auto* sad_tab = SadTabHelper::FromWebContents(resolved[i])) {
+      sad_tab->ReinstallInWebView();
+    }
+  }
+  for (auto& header : headers) {
+    headers_.push_back(AddChildView(std::move(header)));
+  }
+  if (!selection.IsEmpty()) {
+    // A thick square outline of the structural subtree, independent of native
+    // rounded page-focus borders and the header's selected-child bottom rule.
+    selection_outline_ = AddChildView(std::make_unique<views::View>());
+    selection_outline_->SetCanProcessEventsWithinSubtree(false);
+    selection_outline_->GetViewAccessibility().SetIsIgnored(true);
+    selection_outline_->SetBorder(
+        views::CreateSolidBorder(4, ui::kColorFocusableBorderUnfocused));
+    selection_outline_->SetBoundsRect(selection);
+  }
+  return true;
+}
+
+void WorkspaceContentsView::UpdateTitles(
+    const WorkspaceTabbedHeaderView::Titles& titles) {
+  for (auto* header : GetHeaders()) {
+    header->UpdateTitles(titles);
+  }
+}
+
+std::vector<WorkspaceTabbedHeaderView*> WorkspaceContentsView::GetHeaders()
+    const {
+  return {headers_.begin(), headers_.end()};
+}
+
+gfx::Rect WorkspaceContentsView::selection_bounds() const {
+  return selection_outline_ ? selection_outline_->bounds() : gfx::Rect();
+}
+
+void WorkspaceContentsView::Clear() {
+  if (selection_outline_) {
+    auto* outline = selection_outline_.get();
+    selection_outline_ = nullptr;
+    RemoveChildViewT(outline);
+  }
+  while (!headers_.empty()) {
+    auto* header = headers_.back().get();
+    headers_.pop_back();
+    RemoveChildViewT(header);
+  }
+  while (!containers_.empty()) {
+    auto* container = containers_.back().get();
+    containers_.pop_back();
+    container->contents_view()->SetWebContents(nullptr);
+    RemoveChildViewT(container);
+  }
+}
+
+std::vector<ContentsContainerView*>
+WorkspaceContentsView::GetDisplayedContainers() const {
+  return {containers_.begin(), containers_.end()};
+}
+
+BEGIN_METADATA(WorkspaceContentsView)
+END_METADATA
