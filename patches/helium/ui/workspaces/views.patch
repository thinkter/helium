+namespace {
+
+std::u16string SafeTitle(const std::u16string& title) {
+  // Bound untrusted page text before shaping/AX. Drop controls, including bidi
+  // overrides; titles are literal text, never markup or accelerator labels.
+  std::u16string result;
+  for (char16_t ch : title) {
+    if (result.size() == 160) {
+      break;
+    }
+    if (ch >= 0x20 && !(ch >= 0x7f && ch <= 0x9f) && ch != 0x061c &&
+        ch != 0x200e && ch != 0x200f && !(ch >= 0x2028 && ch <= 0x202e) &&
+        !(ch >= 0x2066 && ch <= 0x2069)) {
+      result.push_back(ch);
+    }
+  }
+  // Do not leave a truncated UTF-16 surrogate pair.
+  if (!result.empty() && result.back() >= 0xd800 && result.back() <= 0xdbff) {
+    result.pop_back();
+  }
+  if (result.find_first_not_of(u" \t") == std::u16string::npos) {
+    result = u"Untitled page";
+  }
+  base::i18n::SanitizeUserSuppliedString(&result);
+  return result;
+}
+
+}  // namespace
+
+WorkspaceTabbedHeaderView::WorkspaceTabbedHeaderView(SelectChild select_child)
+    : select_child_(std::move(select_child)) {
+  auto* layout = SetLayoutManager(std::make_unique<views::BoxLayout>(
+      views::BoxLayout::Orientation::kHorizontal));
+  layout->SetDefaultFlex(1);
+  GetViewAccessibility().SetRole(ax::mojom::Role::kTabList);
+  GetViewAccessibility().SetName(u"Container children");
+}
+
+WorkspaceTabbedHeaderView::~WorkspaceTabbedHeaderView() = default;
+
+bool WorkspaceTabbedHeaderView::Update(const WorkspaceLayoutModel& model,
+                                       NodeId container,
+                                       const Titles& titles) {
+  if (!model.Validate()) {
+    return false;
+  }
+  // Only containers reached through the selected paths of the active workspace
+  // can own a visible header. IDs from inactive/hidden subtrees are rejected.
+  std::vector<NodeId> pending;
+  for (const auto& workspace : model.workspaces) {
+    if (workspace.id == model.active_workspace && workspace.root) {
+      pending.push_back(workspace.root);
+    }
+  }
+  bool visible = false;
+  while (!pending.empty()) {
+    NodeId id = pending.back();
+    pending.pop_back();
+    if (id == container) {
+      visible = true;
+      break;
+    }
+    if (const auto* node = std::get_if<ContainerState>(&model.nodes.at(id))) {
+      if (node->layout == LayoutKind::kTabbed) {
+        pending.push_back(node->selected_child);
+      } else {
+        pending.insert(pending.end(), node->children.begin(),
+                       node->children.end());
+      }
+    }
+  }
+  auto it = model.nodes.find(container);
+  const auto* node = it == model.nodes.end()
+                         ? nullptr
+                         : std::get_if<ContainerState>(&it->second);
+  if (!visible || !node || node->layout != LayoutKind::kTabbed) {
+    return false;
+  }
+  weak_factory_.InvalidateWeakPtrs();
+  buttons_.clear();
+  RemoveAllChildViews();
+  container_ = container;
+  selected_child_ = node->selected_child;
+  child_ids_ = node->children;
+  title_keys_.clear();
+  subtrees_.clear();
+  for (NodeId child : child_ids_) {
+    const auto* subtree = std::get_if<ContainerState>(&model.nodes.at(child));
+    NodeId title_leaf = subtree ? subtree->last_focused_leaf : child;
+    title_keys_.push_back(std::get<LeafState>(model.nodes.at(title_leaf)).tab);
+    subtrees_.push_back(subtree != nullptr);
+    auto* button = AddChildView(std::make_unique<views::LabelButton>(
+        base::BindRepeating(&WorkspaceTabbedHeaderView::RequestSelection,
+                            weak_factory_.GetWeakPtr(), child)));
+    buttons_.push_back(button);
+    button->SetEnabled(!select_child_.is_null());
+    button->SetFocusBehavior(FocusBehavior::ALWAYS);
+    button->SetElideBehavior(gfx::ELIDE_TAIL);
+    button->GetViewAccessibility().SetRole(ax::mojom::Role::kTab);
+    button->GetViewAccessibility().SetIsSelected(child == selected_child_);
+    // A bottom rule indicates selected CHILD, not structural selection or page
+    // focus. The latter keeps native button focus-ring behavior.
+    button->SetBorder(views::CreateSolidSidedBorder(
+        gfx::Insets::TLBR(0, 0, child == selected_child_ ? 3 : 0, 0),
+        ui::kColorFocusableBorderFocused));
+  }
+  UpdateTitles(titles);
+  return true;
+}
+
+void WorkspaceTabbedHeaderView::UpdateTitles(const Titles& titles) {
+  for (size_t i = 0; i < buttons_.size(); ++i) {
+    auto it = titles.find(title_keys_[i]);
+    std::u16string title = SafeTitle(it == titles.end() ? u"" : it->second);
+    if (subtrees_[i]) {
+      title = u"Layout: " + title;
+    }
+    buttons_[i]->SetText(title);
+    buttons_[i]->GetViewAccessibility().SetName(title);
+    buttons_[i]->SetTooltipText(title);
+  }
+}
+
+void WorkspaceTabbedHeaderView::RequestSelection(NodeId child) {
+  if (!select_child_ || !std::ranges::contains(child_ids_, child)) {
+    return;
+  }
+  // The callback may synchronously rebuild/delete this surface. Copy it, and
+  // do not access members after dispatch. Weak button callbacks expire on
+  // Update.
+  auto callback = select_child_;
+  callback.Run(container_, child);
+}
