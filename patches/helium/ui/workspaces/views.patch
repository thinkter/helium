+BASE_FEATURE(kWorkspaceContentsHost, base::FEATURE_DISABLED_BY_DEFAULT);
+
+WorkspaceContentsView::WorkspaceContentsView(BrowserView* browser_view)
+    : browser_view_(browser_view) {
+  CHECK(browser_view_);
+  CHECK(base::FeatureList::IsEnabled(kWorkspaceContentsHost));
+  // Geometry already mirrors physical horizontal coordinates in RTL. Disable
+  // parent mirroring only; native leaf contents retain their own text
+  // direction.
+  SetMirrored(false);
+  SetCanProcessEventsWithinSubtree(false);
+}
+
+WorkspaceContentsView::~WorkspaceContentsView() {
+  Clear();
+}
+
+bool WorkspaceContentsView::Present(
+    const WorkspaceLayoutModel& model,
+    const LayoutMetrics& metrics,
+    const std::map<TabKey, content::WebContents*>& contents) {
+  if (presenting_) {
+    return false;
+  }
+  base::AutoReset<bool> presenting(&presenting_, true);
+  const double scale = metrics.device_scale_factor;
+  const double pixel_width = std::round(width() * scale);
+  const double pixel_height = std::round(height() * scale);
+  if (!std::isfinite(scale) || scale <= 0 || !std::isfinite(pixel_width) ||
+      !std::isfinite(pixel_height) ||
+      pixel_width > std::numeric_limits<int>::max() ||
+      pixel_height > std::numeric_limits<int>::max()) {
+    return false;
+  }
+  const auto geometry =
+      CalculateWorkspaceGeometry(model, static_cast<int>(pixel_width),
+                                 static_cast<int>(pixel_height), metrics);
+  if (!geometry.valid) {
+    return false;
+  }
+
+  std::vector<content::WebContents*> resolved;
+  std::vector<gfx::Rect> bounds;
+  std::set<content::WebContents*> unique;
+  for (const auto& leaf : geometry.leaves) {
+    auto it = contents.find(std::get<LeafState>(model.nodes.at(leaf.node)).tab);
+    if (it == contents.end() || !it->second ||
+        it->second->GetBrowserContext() != browser_view_->GetProfile() ||
+        !unique.insert(it->second).second) {
+      return false;
+    }
+    // Round shared edges, never widths independently. Pin viewport edges to
+    // their original DIPs, including sub-unit scales and zero-area projections.
+    auto edge = [scale](int value, int pixels, int dips) {
+      if (value == pixels) {
+        return dips;
+      }
+      return std::clamp(static_cast<int>(std::round(value / scale)), 0, dips);
+    };
+    const auto& r = leaf.bounds;
+    const int x = edge(r.x, pixel_width, width());
+    const int y = edge(r.y, pixel_height, height());
+    const int right = edge(r.x + r.width, pixel_width, width());
+    const int bottom = edge(r.y + r.height, pixel_height, height());
+    if (right <= x || bottom <= y) {
+      // Do not claim a displayed leaf that Views cannot represent in DIPs.
+      return false;
+    }
+    bounds.emplace_back(x, y, right - x, bottom - y);
+    resolved.push_back(it->second);
+  }
+
+  // Detach all old contents before attaching any new ones: a selected subtree
+  // can reorder/reuse the same externally owned pages in different slots.
+  Clear();
+  for (size_t i = 0; i < resolved.size(); ++i) {
+    auto* container =
+        AddChildView(std::make_unique<ContentsContainerView>(browser_view_));
+    containers_.push_back(container);
+    container->SetBoundsRect(bounds[i]);
+    container->contents_view()->SetWebContents(resolved[i]);
+    if (auto* sad_tab = SadTabHelper::FromWebContents(resolved[i])) {
+      sad_tab->ReinstallInWebView();
+    }
+  }
+  return true;
+}
+
+void WorkspaceContentsView::Clear() {
+  while (!containers_.empty()) {
+    auto* container = containers_.back().get();
+    containers_.pop_back();
+    container->contents_view()->SetWebContents(nullptr);
+    RemoveChildViewT(container);
+  }
+}
+
+std::vector<ContentsContainerView*>
+WorkspaceContentsView::GetDisplayedContainers() const {
+  return {containers_.begin(), containers_.end()};
+}
